---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REVIEWS, GOOGLE_RATING, REVIEWS_URL, WRITE_REVIEW_URL } from '../data/reviews';
import { FEATURED_TESTIMONIALS, TESTIMONIAL_VIDEOS } from '../data/videos';
import VideoTestimonial from '../components/VideoTestimonial.astro';
---

<BaseLayout
  title="Reviews"
  description={`Rated ${GOOGLE_RATING.stars.toFixed(1)} on Google. Reviews and video testimonials for Jamie Atlas — rehabilitation and return-to-sport coaching in Denver.`}
>
  <section class="px-6 pt-16 pb-12 md:pt-24">
    <div class="max-w-3xl mx-auto">
      <p class="font-serif italic text-[var(--color-primary)] mb-3 text-lg">Reviews</p>
      <h1 class="mb-8">Rated {GOOGLE_RATING.stars.toFixed(1)} on Google</h1>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed">
        Every review below is verbatim from Google — verifiable, unedited, unpaid.
      </p>
    </div>
  </section>

  <section class="px-6 py-16 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-3xl mx-auto">
      <div class="space-y-10">
        {REVIEWS.map(r => (
          <blockquote class="border-l-4 border-[var(--color-primary)] pl-6">
            <p class="text-lg leading-relaxed mb-3">"{r.text}"</p>
            <footer class="text-[var(--color-text-muted)]">— {r.name}</footer>
          </blockquote>
        ))}
      </div>
      <p class="mt-12">
        <a href={REVIEWS_URL} class="font-semibold">Read all {GOOGLE_RATING.count} reviews on Google →</a>
      </p>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-4">Watch it happen</h2>
      <p class="text-lg text-[var(--color-text-muted)] mb-10">
        Real clients, real sessions — including back pain changing inside a single visit.
      </p>
      <div class="grid gap-14">
        {FEATURED_TESTIMONIALS.map(v => <VideoTestimonial video={v} headingLevel="h3" />)}
      </div>
      <p class="mt-12">
        <a href="/testimonials" class="font-semibold">
          Watch all {TESTIMONIAL_VIDEOS.length} client videos →
        </a>
      </p>
    </div>
  </section>

  <section class="px-6 py-20 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="mb-6">Worked with Jamie?</h2>
      <p class="text-lg text-[var(--color-text-muted)] mb-8">
        A Google review helps other people in pain find their way here.
      </p>
      <a href={WRITE_REVIEW_URL} class="cta-button text-lg">Leave a Google review</a>
    </div>
  </section>
</BaseLayout>
