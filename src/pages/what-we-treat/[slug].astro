---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { CONDITIONS } from '../../data/conditions';
import { testimonialsFor, testimonialCount, TESTIMONIAL_VIDEOS } from '../../data/videos';
import VideoBanner from '../../components/VideoBanner.astro';
import SpeedExplainer from '../../components/SpeedExplainer.astro';

export function getStaticPaths() {
  return CONDITIONS.map(condition => ({
    params: { slug: condition.slug },
    props: { condition },
  }));
}

const { condition } = Astro.props;

const videoTotal = testimonialCount(condition.slug);

// Rotating banner replaces the three in-page video placements (Jamie,
// 2026-08-08): body-part pages rotate ONLY their own body part's clips;
// every other condition page rotates through the full library.
const BODY_PART_SLUGS = ['chronic-back-pain', 'sciatica', 'neck-pain', 'shoulder-pain', 'knee-pain'];
const bannerVideos = BODY_PART_SLUGS.includes(condition.slug)
  ? testimonialsFor(condition.slug, 99)
  : TESTIMONIAL_VIDEOS;
const midPoint = Math.ceil(condition.sections.length / 2);

// Intro and section paragraphs render with set:html so copy can carry a single
// bolded POWER LINE — the sentence a scanner should still catch if they read
// nothing else. Our own content only; no user input reaches this.

const related = condition.related
  .map(slug => CONDITIONS.find(c => c.slug === slug))
  .filter(Boolean);

const medicalPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: condition.metaTitle,
  url: `${SITE.url}/what-we-treat/${condition.slug}`,
  about: { '@type': condition.schemaType ?? 'MedicalCondition', name: condition.navTitle },
  reviewedBy: { '@type': 'Person', name: 'Jamie Atlas' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: condition.faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={condition.metaTitle} description={condition.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(medicalPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="px-6 pt-16 pb-12 md:pt-24">
    <div class="max-w-3xl mx-auto">
      <p class="font-serif italic text-[var(--color-primary)] mb-3 text-lg">
        <a href="/what-we-treat" class="no-underline">What we treat</a> · {condition.navTitle}
      </p>
      <h1 class="mb-8">{condition.title}</h1>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed" set:html={condition.intro} />
      <!-- Cold-traffic trust anchor: these pages receive first-touch visitors
           (business-card QR jamieatlas.com/ready lands on post-surgical; future
           Google Ads land here too). One line of who-is-this. -->
      <p class="mt-6 text-base font-semibold text-[var(--color-primary)]">
        Jamie Atlas — Pain &amp; Performance Specialist · 5× 5280 Top of the Town winner · 9NEWS Fitness Expert
      </p>
      <!-- Early CTA: without this, a phone visitor's first Book button is
           several screens down. QR and ad traffic needs one near the top. -->
      <p class="mt-7">
        <a href="/book" class="cta-button">Book a 30-minute consultation</a>
      </p>
    </div>
  </section>

  <section class="px-6 pb-14">
    <div class="max-w-5xl mx-auto">
      <VideoBanner slides={bannerVideos.map(v => ({ video: v }))} />
    </div>
  </section>

  {condition.sections.slice(0, midPoint).map((section, i) => (
    <section class={`px-6 py-14 ${i % 2 === 0 ? 'bg-[var(--color-surface)] border-y border-[var(--color-border)]' : ''}`}>
      <div class="max-w-3xl mx-auto">
        <h2 class="mb-6">{section.heading}</h2>
        <div class="condition-copy space-y-5 text-lg text-[var(--color-text-muted)] leading-relaxed">
          {section.paragraphs.map((p, pi) => (
            <Fragment>
              {pi > 0 && (
                <div class="flex items-center gap-2 pt-1 pb-1" aria-hidden="true">
                  <span class="h-px w-10 bg-[var(--color-primary)] opacity-30"></span>
                  <span class="h-1 w-1 rounded-full bg-[var(--color-primary)] opacity-40"></span>
                  <span class="h-1 w-1 rounded-full bg-[var(--color-primary)] opacity-40"></span>
                  <span class="h-1 w-1 rounded-full bg-[var(--color-primary)] opacity-40"></span>
                </div>
              )}
              <p set:html={p} />
            </Fragment>
          ))}
        </div>
      </div>
    </section>
  ))}

  {condition.sections.slice(midPoint).map((section, i) => (
    <section class={`px-6 py-14 ${(i + midPoint) % 2 === 0 ? 'bg-[var(--color-surface)] border-y border-[var(--color-border)]' : ''}`}>
      <div class="max-w-3xl mx-auto">
        <h2 class="mb-6">{section.heading}</h2>
        <div class="condition-copy space-y-5 text-lg text-[var(--color-text-muted)] leading-relaxed">
          {section.paragraphs.map((p, pi) => (
            <Fragment>
              {pi > 0 && (
                <div class="flex items-center gap-2 pt-1 pb-1" aria-hidden="true">
                  <span class="h-px w-10 bg-[var(--color-primary)] opacity-30"></span>
                  <span class="h-1 w-1 rounded-full bg-[var(--color-primary)] opacity-40"></span>
                  <span class="h-1 w-1 rounded-full bg-[var(--color-primary)] opacity-40"></span>
                  <span class="h-1 w-1 rounded-full bg-[var(--color-primary)] opacity-40"></span>
                </div>
              )}
              <p set:html={p} />
            </Fragment>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="px-6 py-16 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-10">Common questions</h2>
      <div class="space-y-8">
        {condition.faq.map(item => (
          <div>
            <h3 class="mb-3">{item.q}</h3>
            <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-5xl mx-auto">
      <SpeedExplainer compact={true} />
      <p class="mt-8">
        <a href={`/testimonials#${condition.slug}`} class="font-semibold">
          {videoTotal > 0
            ? `All ${videoTotal} ${condition.navTitle.toLowerCase()} videos →`
            : 'All client results →'}
        </a>
      </p>
    </div>
  </section>

  {condition.nextStep && (
    <section class="px-6 py-14">
      <div class="max-w-3xl mx-auto">
        <h2 class="mb-5">{condition.nextStep.heading}</h2>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-6">{condition.nextStep.body}</p>
        <ul class="space-y-2">
          {condition.nextStep.links.map(l => (
            <li><a href={l.slug}>{l.label} →</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="px-6 py-14 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
      <div class="max-w-3xl mx-auto">
        <h2 class="mb-8">Related to this</h2>
        <ul class="space-y-6">
          {related.map(r => (
            <li>
              <a href={`/what-we-treat/${r.slug}`} class="font-serif text-xl">{r.title}</a>
              <p class="mt-2 text-[var(--color-text-muted)] leading-relaxed">{r.metaDescription}</p>
            </li>
          ))}
        </ul>
        <p class="mt-8">
          <a href="/what-we-treat">See everything we treat</a>
        </p>
      </div>
    </section>
  )}

  <section class="px-6 py-20 bg-[var(--color-primary)] text-on-dark">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="mb-6 text-white">Find out if this is your way out</h2>
      <p class="text-xl mb-10 opacity-95">
        A 30-minute consultation — your story, my honest read on whether I can help, and a clear plan if I can.
      </p>
      <a href="/book" class="cta-button cta-button-accent text-lg">Book a consultation</a>
      <p class="mt-8 text-sm opacity-80">
        Or call <a href={`tel:${SITE.contact.phoneTel}`} class="text-white underline">{SITE.contact.phone}</a>
        · <a href="/how-it-works" class="text-white underline">See how it works</a>
      </p>
    </div>
  </section>
</BaseLayout>
