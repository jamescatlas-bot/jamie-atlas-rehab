---
import BaseLayout from '../layouts/BaseLayout.astro';
import BannerSection from '../components/BannerSection.astro';
import { SITE } from '../data/site';
import { PRESS_VIDEOS } from '../data/videos';
import PressStrip from '../components/PressStrip.astro';

// The homepage strip shows six logos, so this page accounts for all of them —
// a strip that claims more outlets than the page can name reads as a bluff.
//
// Jamie confirmed 2026-08-06 he appeared in all of these. For FIVE of them he
// will NOT be supplying segment or article links, so those notes are
// deliberately written to be true and defensible without naming a dated item.
// Don't add specifics that aren't evidenced, and don't ask him for those links
// again.
//
// EXCEPTION (2026-08-12): he supplied nine Denver Post URLs unprompted. Eight
// are listed in DENVER_POST_SERIES below (the ninth, a 2016 body-composition
// column, was dropped on purpose — wrong positioning for a rehab practice).
// Denver Post owns that text: link and cite only, never republish or reword it.
const OUTLET_NOTES = [
  {
    name: '9NEWS',
    note: "Denver's NBC affiliate, and the longest-running of these. Recurring fitness and movement segments — the clips above are a selection.",
  },
  {
    name: 'FOX31 Denver',
    note: 'In-studio segments on training, injury and keeping active through the Colorado seasons.',
  },
  {
    name: 'Denver7',
    note: 'Contributed as a local expert on movement, strength and staying in your sport as you get older.',
  },
  {
    name: '5280 Magazine',
    note: "Denver's city magazine — contributed expert commentary on training and injury for a Denver readership.",
  },
  {
    name: 'The Denver Post',
    note: 'Ran a functional-fitness column built around exercises I designed and directed — eight of them are linked above. Also contributed on training smarter, and on a coaching approach that treats strength as the foundation of long-term health rather than a cosmetic goal.',
  },
  {
    name: "Runner's World",
    note: 'Contributed expert commentary for runners — load, recurring injury, and the training that keeps people running for decades rather than seasons.',
  },
  {
    name: 'UPWARD Women',
    note: 'Profiled on coaching, movement confidence, and helping women over 40 get strong without fear or gimmicks.',
  },
];

// Denver Post functional-fitness series. URLs verified live and free to read
// 2026-08-12. Where an article on this site covers the same ground, `resource`
// links the two so the archive and the resources reinforce each other.
const DENVER_POST_SERIES = [
  {
    headline: 'Step-up exercise gives hikers a leg up',
    date: '25 July 2010',
    note: 'Hiking-specific glute and quad loading.',
    href: 'https://www.denverpost.com/2010/07/25/step-up-exercise-gives-hikers-a-leg-up/',
    resource: '/resources/hiking-conditioning',
  },
  {
    headline: 'Build pedal power for speed, stamina',
    date: '15 August 2010',
    note: 'Single-leg loading for the bottom of the pedal stroke.',
    href: 'https://www.denverpost.com/2010/08/15/build-pedal-power-for-speed-stamina/',
    resource: '/resources/road-cycling-power',
  },
  {
    headline: "Learn to maintain balance while your body's in motion",
    date: '3 October 2010',
    note: 'Why balance fails in motion, not in stillness.',
    href: 'https://www.denverpost.com/2010/10/03/learn-to-maintain-balance-while-your-bodys-in-motion/',
    resource: '/resources/balance-training',
  },
  {
    headline: 'Shake up your ski shape-up',
    date: '4 December 2010',
    note: 'Ski conditioning beyond the squat and the lunge, with my six-point pre-season list.',
    href: 'https://www.denverpost.com/2010/12/04/shake-up-your-ski-shape-up/',
    resource: '/resources/ski-season-prep',
  },
  {
    headline: "Runner's pull with band",
    date: '17 April 2011',
    note: 'Restoring the upper-to-lower body connection runners lose over winter.',
    href: 'https://www.denverpost.com/2011/04/17/runners-pull-with-band/',
    resource: '/resources/running-return-to-training',
  },
  {
    headline: 'Better backs for bent bikers',
    date: '15 May 2011',
    note: "Why cyclists' low backs hurt when the problem is at the hip.",
    href: 'https://www.denverpost.com/2011/05/15/better-backs-for-bent-bikers/',
    resource: '/resources/cycling-low-back-pain',
  },
  {
    headline: 'Keep your shoulders working swimmingly',
    date: '18 September 2011',
    note: 'Rotator cuff pain that starts at the shoulder blade and mid-back.',
    href: 'https://www.denverpost.com/2011/09/18/keep-your-shoulders-working-swimmingly/',
    resource: '/resources/swimmers-shoulder',
  },
  {
    headline: 'Venturing into backcountry? This will prep you for powder',
    date: '23 December 2011',
    note: 'Loading the wide, high step that snowshoeing demands.',
    href: 'https://www.denverpost.com/2011/12/23/venturing-into-backcountry-this-will-prep-you-for-powder-2/',
    resource: '/resources/snowshoe-preparation',
  },
];
---

<BaseLayout
  title="Press & Media — Jamie Atlas, Denver"
  description="Jamie Atlas in the media — 9NEWS, FOX31, Denver7, 5280, The Denver Post and Runner's World. Segments, contributions and expert commentary from twenty years of Denver coaching."
>
  <section class="px-6 pt-16 pb-12 md:pt-24">
    <div class="max-w-3xl mx-auto">
      <p class="font-serif italic text-[var(--color-primary)] mb-3 text-lg">Press</p>
      <h1 class="mb-8">Seen in, and contributed to</h1>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed">
        Twenty years in Denver means a lot of camera time and a lot of people asking for a straight answer about
        backs, knees and getting older. <strong class="text-[var(--color-text)]">Most of what follows is
        contribution, not coverage</strong> — segments recorded, questions answered, commentary given. The clips
        are below.
      </p>
    </div>
  </section>

  <!-- Site-wide rotating video banner (Jamie, 2026-08-08) -->
  <BannerSection />

  <PressStrip />

  <section class="px-6 py-16 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-10">9NEWS segments</h2>
      <div class="grid md:grid-cols-2 gap-8">
        {PRESS_VIDEOS.map(v => (
          <figure>
            <div class="rounded-xl overflow-hidden border border-[var(--color-border)] aspect-video">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                title={v.title}
                width="100%"
                height="100%"
                frameborder="0"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
            <figcaption class="mt-3 text-sm text-[var(--color-text-muted)]">{v.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-4">Beyond 9NEWS</h2>
      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-10 max-w-3xl">
        The segments were never limited to one station. Here on Denver7, talking seasonal nutrition — a reminder
        that the expert chair covered the whole picture of health, not just the exercise half.
      </p>
      <div class="grid md:grid-cols-2 gap-8">
        <figure>
          <div class="rounded-xl overflow-hidden border border-[var(--color-border)] aspect-video">
            <iframe
              src="https://www.youtube-nocookie.com/embed/Cko37-BwqTs"
              title="Avoiding holiday weight gain — Denver7"
              width="100%"
              height="100%"
              frameborder="0"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <figcaption class="mt-3 text-sm text-[var(--color-text-muted)]">
            Avoiding holiday weight gain — as the guest expert on Denver7.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="px-6 py-16 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-4">From the archive: proving it works, since the beginning</h2>
      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-10 max-w-3xl">
        Over thirteen years ago, so many clients were getting out of pain quickly that people frankly doubted it.
        So we started filming. This is the very first before-and-after video we ever made — Jess, a 7/10 elbow
        pain, changed in two minutes on camera. The production values have improved since. The approach that made
        it possible is the same one running the studio today, now documented in
        <a href="/testimonials">23 client videos</a>.
      </p>
      <div class="grid md:grid-cols-2 gap-8">
        <figure>
          <div class="rounded-xl overflow-hidden border border-[var(--color-border)] aspect-video">
            <iframe
              src="https://www.youtube-nocookie.com/embed/ocdekC71prI"
              title="Jess's 7/10 elbow pain changed in 2 minutes — the first before/after video, 13+ years ago"
              width="100%"
              height="100%"
              frameborder="0"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <figcaption class="mt-3 text-sm text-[var(--color-text-muted)]">
            The first before/after, from the archive. Your results may vary.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-8">Television &amp; community appearances</h2>
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <figure>
          <img
            src="/press-livewell.jpg"
            alt="Jamie Atlas speaking on stage at a LiveWell Colorado workplace wellness event in downtown Denver"
            width="1200"
            height="799"
            loading="lazy"
            class="rounded-xl border border-[var(--color-border)] w-full"
          />
          <figcaption class="mt-3 text-sm text-[var(--color-text-muted)]">
            Speaking at a LiveWell Colorado workplace-wellness event in downtown Denver, alongside city officials.
          </figcaption>
        </figure>
        <figure>
          <img
            src="/press-fox31.jpg"
            alt="Jamie Atlas on set at FOX31 Denver"
            width="440"
            height="528"
            loading="lazy"
            class="rounded-xl border border-[var(--color-border)] w-full max-w-xs"
          />
          <figcaption class="mt-3 text-sm text-[var(--color-text-muted)]">
            On set at FOX31 Denver.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="px-6 py-16 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-4">The Denver Post functional-fitness series, 2010–2011</h2>
      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-10">
        For two years The Denver Post ran a functional-fitness column built around exercises I designed and directed.
        Eight of those columns are below. They were published under Bonza Bodies, the practice I ran before I moved
        into clinical rehabilitation — <strong class="text-[var(--color-text)]">the brand changed, the thinking
        didn't</strong>. Every one of them starts from the same question I still start from: what is this body actually
        being asked to do, and what is stopping it?
      </p>
      <ol class="space-y-7 list-none pl-0">
        {DENVER_POST_SERIES.map(item => (
          <li>
            <a href={item.href} target="_blank" rel="noopener" class="text-lg font-semibold">{item.headline}</a>
            <p class="mt-1 text-base text-[var(--color-text-muted)] leading-relaxed">
              The Denver Post, {item.date} · {item.note}
              {' '}<a href={item.resource}>Read my current article on this</a>.
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-10">Outlets</h2>
      <div class="space-y-10">
        {OUTLET_NOTES.map(o => (
          <div>
            <h3 class="text-2xl mb-4">{o.name}</h3>
            <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">{o.note}</p>
          </div>
        ))}
      </div>

      <div class="mt-14">
        <h2 class="text-2xl mb-4">Media inquiries</h2>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
          For interviews, expert commentary on pain science and masters athletics, or speaking engagements, email
          <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
