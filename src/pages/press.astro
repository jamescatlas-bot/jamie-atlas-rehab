---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { PRESS_VIDEOS } from '../data/videos';
---

<BaseLayout
  title="Press & Media"
  description="Jamie Atlas in the media — 9News fitness segments, the Denver Post and UPWARD Women. Watch the clips from 30 years of Denver rehab coaching."
>
  <section class="px-6 pt-16 pb-12 md:pt-24">
    <div class="max-w-3xl mx-auto">
      <p class="font-serif italic text-[var(--color-primary)] mb-3 text-lg">Press</p>
      <h1 class="mb-8">In the media</h1>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed">
        Jamie is a recurring fitness expert on 9News (Denver's NBC affiliate) and has been featured in the Denver
        Post and by UPWARD Women. Watch the segments below.
      </p>
    </div>
  </section>

  <section class="px-6 py-16 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-10">9News segments</h2>
      <div class="grid md:grid-cols-2 gap-8">
        {PRESS_VIDEOS.map(v => (
          <figure>
            <div class="rounded-xl overflow-hidden border border-[var(--color-border)] aspect-video">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                title={v.title}
                width="100%"
                height="100%"
                frameborder="0"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
            <figcaption class="mt-3 text-sm text-[var(--color-text-muted)]">{v.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-8">Television &amp; community appearances</h2>
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <figure>
          <img
            src="/press-livewell.jpg"
            alt="Jamie Atlas speaking on stage at a LiveWell Colorado workplace wellness event in downtown Denver"
            width="1200"
            height="799"
            loading="lazy"
            class="rounded-xl border border-[var(--color-border)] w-full"
          />
          <figcaption class="mt-3 text-sm text-[var(--color-text-muted)]">
            Speaking at a LiveWell Colorado workplace-wellness event in downtown Denver, alongside city officials.
          </figcaption>
        </figure>
        <figure>
          <img
            src="/press-fox31.jpg"
            alt="Jamie Atlas on set at FOX31 Denver"
            width="440"
            height="528"
            loading="lazy"
            class="rounded-xl border border-[var(--color-border)] w-full max-w-xs"
          />
          <figcaption class="mt-3 text-sm text-[var(--color-text-muted)]">
            On set at FOX31 Denver.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="px-6 pb-16">
    <div class="max-w-3xl mx-auto space-y-10">
      <div>
        <h2 class="text-2xl mb-4">The Denver Post</h2>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
          Featured in the Denver Post for his work helping Denver adults train smarter — and for a coaching
          philosophy that treats strength as the foundation of long-term health.
        </p>
      </div>
      <div>
        <h2 class="text-2xl mb-4">UPWARD Women</h2>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
          Profiled by UPWARD Women on coaching, movement confidence, and helping women 40+ get strong without fear
          or gimmicks.
        </p>
      </div>
      <div>
        <h2 class="text-2xl mb-4">Media inquiries</h2>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
          For interviews, expert commentary on pain science and masters athletics, or speaking engagements, email
          <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
