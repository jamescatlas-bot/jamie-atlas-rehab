---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BannerSection from '../../components/BannerSection.astro';
import { SITE } from '../../data/site';

// Articles land here from the monthly content-production pipeline
// (content_drafts/ → reviewed → published as markdown under src/content/resources/).
// Until the content collection is wired up, list them manually here.
const articles: { title: string; slug: string; description: string; date: string }[] = [
  {
    title: 'Ski season prep: the complete Denver guide',
    slug: 'ski-season-prep',
    description:
      'The four jobs of ski prep — strength, balance, mobility, endurance — with three 9NEWS segments and links to the whole ski series. Start here.',
    date: '2026-08-11',
  },
  {
    title: 'Ski squats: train for the turn, not the gym',
    slug: 'ski-squats',
    description:
      'Why the standard squat is the wrong shape for skiing, four variations that match the turn, and what to do if your knee already hurts.',
    date: '2026-08-02',
  },
  {
    title: 'Balance training: train the recovery, not just the legs',
    slug: 'balance-training',
    description:
      'Strong legs get you down the mountain. Balance is what saves you when an edge catches. Four progressions — plus the 9NEWS segment where Jamie demonstrates all of them.',
    date: '2026-08-10',
  },
  {
    title: 'Ski stretches that actually help',
    slug: 'ski-stretches',
    description:
      'The mobility side of ski prep — what to stretch, when it helps, when it does not, and the archive video from Jamie’s early Denver ski conditioning years.',
    date: '2026-08-11',
  },
  {
    title: 'Snowboard conditioning: train for the board, not the skis',
    slug: 'snowboard-conditioning',
    description:
      'Riding is sideways, rotational, and falls on its hands. The conditioning that matches a board stance — with the 9NEWS segment.',
    date: '2026-08-11',
  },
  {
    title: 'Hiking conditioning: it’s the downhills that get you',
    slug: 'hiking-conditioning',
    description:
      'Colorado hiking is a braking sport. The eccentric strength and stretches that protect knees on the descent — with the 9NEWS segment.',
    date: '2026-08-11',
  },
  {
    title: 'Mountain biking: the skills start in your body',
    slug: 'mountain-biking-conditioning',
    description:
      'Hinge endurance, grip that outlasts the descent, and reactive balance — the physical platform under every riding skill, with the 9NEWS segment.',
    date: '2026-08-11',
  },
  {
    title: 'Golf conditioning: a swing that lasts',
    slug: 'golf-conditioning',
    description:
      'The swing is the fastest rotation most bodies ever produce. Mobility and strength that protect the back and add distance — with the 9NEWS segment.',
    date: '2026-08-11',
  },
  {
    title: 'Shoulder exercises that won’t cause aggravation',
    slug: 'shoulder-exercises',
    description:
      'Training a cranky shoulder without poking the bear: why rest backfires, and the principles behind non-aggravating shoulder work.',
    date: '2026-08-11',
  },
  {
    title: 'Desk posture: what actually helps',
    slug: 'desk-posture',
    description:
      'It’s probably not your posture alone — it’s the hours in one shape. What helps during a downtown workday, with the 9NEWS segment.',
    date: '2026-08-11',
  },
  {
    title: 'Glute exercises: the missing piece in most back and knee stories',
    slug: 'glute-exercises',
    description:
      'Glutes work at angles, not just straight ahead — and when they under-deliver, backs and knees pay. Three exercises worth adding, with the 9NEWS segment.',
    date: '2026-08-11',
  },
  {
    title: 'Resistance band training: the honest home gym',
    slug: 'resistance-band-training',
    description:
      'Bands make rotation and angles easy to train at home — how to use them properly, with the 9NEWS segment.',
    date: '2026-08-11',
  },
  {
    title: 'A workout your kids are allowed to interrupt',
    slug: 'family-workout',
    description:
      'Movement-pattern training that survives real family life — and why the example matters as much as the exercise. With the 9NEWS segment.',
    date: '2026-08-11',
  },
  {
    title: 'Holiday nutrition: skip the January penance',
    slug: 'holiday-nutrition',
    description:
      'The holidays are not the problem — the January overcorrection is. A saner way through the season, from Jamie’s Denver7 guest-expert segment.',
    date: '2026-08-11',
  },
];
---

<BaseLayout
  title="Free Rehab & Training Resources — Denver"
  description="Articles on chronic pain, return-to-sport rehabilitation, and staying in your sport after 40 — from Jamie Atlas Rehab & Performance in Denver."
>
  <section class="px-6 pt-16 pb-12 md:pt-24">
    <div class="max-w-3xl mx-auto">
      <p class="font-serif italic text-[var(--color-primary)] mb-3 text-lg">Resources</p>
      <h1 class="mb-8">Straight answers about pain and performance</h1>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed">
        Articles on specific conditions, specific sports, and the evidence behind getting back to both. No fear, no
        fluff.
      </p>
    </div>
  </section>

  <!-- Site-wide rotating video banner (Jamie, 2026-08-08) -->
  <BannerSection />

  <section class="px-6 py-16 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-3xl mx-auto">
      {articles.length > 0 ? (
        <div class="space-y-8">
          {articles.map(a => (
            <a href={`/resources/${a.slug}`} class="block no-underline group">
              <h2 class="text-2xl mb-2 text-[var(--color-primary)] group-hover:text-[var(--color-primary-dark)]">{a.title}</h2>
              <p class="text-[var(--color-text-muted)] leading-relaxed">{a.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-8">
          <p class="text-lg text-[var(--color-text-muted)] leading-relaxed max-w-xl mx-auto">
            First articles are in production. While you wait, the
            <a href="/what-we-treat">What We Treat</a> pages cover the most common questions about chronic back pain,
            sciatica, post-surgical recovery, and masters athlete injuries.
          </p>
        </div>
      )}
    </div>
  </section>

  <section class="px-6 py-20">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="mb-6">Have a question an article should answer?</h2>
      <p class="text-lg text-[var(--color-text-muted)] mb-8">
        Email <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a> — reader questions become future
        articles.
      </p>
    </div>
  </section>
</BaseLayout>
