---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BannerSection from '../../components/BannerSection.astro';
import ResourceVideo from '../../components/ResourceVideo.astro';
import { SITE } from '../../data/site';

const title = 'Resistance Band Training at Home: The Honest Home Gym';
const description =
  'Bands make the training that matters most — rotation, angles, control — easy to do in a living room. How to use them properly, with the 9NEWS segment.';
const published = '2026-08-11';
const url = `${SITE.url}/resources/resistance-band-training`;

const faq = [
  {
    q: 'Are resistance bands as effective as weights?',
    a: 'For most goals, more effective than they get credit for. Muscle responds to tension and progression, and bands deliver both — with a property free weights lack: resistance that changes through the range. They will not replace a barbell for maximal strength, but for control, rehab-adjacent work and staying strong at home, they cover a remarkable amount of ground.',
  },
  {
    q: 'What is the biggest mistake people make with bands?',
    a: 'Treating them as a lighter version of dumbbell training — same straight-line exercises, less resistance, faster reps. The band’s real gift is direction: anchor one to a door and you can load rotation, diagonals and angles that dumbbells handle awkwardly. Slow down, control the return (the band always wants to snap back faster than it should), and train the angles you actually live in.',
  },
  {
    q: 'Which band exercises matter most?',
    a: 'If I could only keep three families: rows and pull-aparts (the anti-desk medicine most bodies are starved of), chops and rotational presses (the rotation principle that runs through every sport article on this site), and band-resisted hip work — bridges, side steps, single-leg patterns — because the glutes are where most back and knee stories quietly begin.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url,
  datePublished: published,
  author: { '@type': 'Person', name: 'Jamie Atlas' },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="px-6 pt-16 pb-12 md:pt-24">
    <div class="max-w-3xl mx-auto">
      <p class="font-serif italic text-[var(--color-primary)] mb-3 text-lg">
        <a href="/resources" class="no-underline">Resources</a> · Home training
      </p>
      <h1 class="mb-8">Resistance band training: the honest home gym</h1>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed">
        A few dollars of latex will not impress anyone at a gym. But a band does something valuable no dumbbell
        can: <strong class="text-[var(--color-text)]">it makes training rotation and angles easy</strong> — and
        that is the training most bodies are missing.
      </p>
    </div>
  </section>

  <!-- Site-wide rotating video banner (Jamie, 2026-08-08) -->
  <BannerSection />

  <section class="px-6 py-14 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-6">Watch the segment</h2>
      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-8">
        Resistance band exercises for working out at home, from my 9NEWS years.
      </p>
      <ResourceVideo
        id="5Wc-YTnmmgE"
        title="Resistance band exercises for working out at home — 9NEWS"
        caption="From my recurring 9NEWS fitness segments."
      />
    </div>
  </section>

  <section class="px-6 py-14">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-6">Getting more out of a band than most people do</h2>
      <div class="space-y-5 text-lg text-[var(--color-text-muted)] leading-relaxed">
        <p>
          <strong>Use the direction, not just the resistance.</strong> Anchored to a door hinge, a band lets you
          load chops, diagonal presses and rotations through exactly the angles daily life and sport use — the same
          principle behind the <a href="/resources/ski-squats">rotational ski squat</a> and the
          <a href="/resources/golf-conditioning">golf swing work</a>. Dumbbells fight gravity in one direction; a
          band pulls from wherever you anchor it.
        </p>
        <p>
          <strong>Own the return trip.</strong> The band always wants to snap back faster than it should. Resisting
          that — three slow seconds on the way back — is where much of the value lives, and it is the part most
          home trainees skip entirely.
        </p>
        <p>
          <strong>Progress deliberately.</strong> Thicker band, slower tempo, more range, single-limb versions —
          progression is what turns convenience into results. And if one side never matches the other, or something
          aches after sessions, that is information worth a professional look: home training's real weakness is not
          the equipment, it is that nobody is watching the compensations.
        </p>
      </div>
    </div>
  </section>

  <section class="px-6 py-16 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-10">Common questions</h2>
      <div class="space-y-8">
        {faq.map(item => (
          <div>
            <h3 class="mb-3">{item.q}</h3>
            <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-20 bg-[var(--color-primary)] text-on-dark">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="mb-6 text-white">Want your home program checked before it grooves a bad habit?</h2>
      <p class="text-xl mb-10 opacity-95">
        A 30-minute consultation — your history, my honest read on whether I can help, and a clear plan if I can.
        One assessment can set up months of confident solo training.
      </p>
      <a href="/book" class="cta-button cta-button-accent text-lg">Book a consultation</a>
      <p class="mt-8 text-sm opacity-80">
        Or call <a href={`tel:${SITE.contact.phoneTel}`} class="text-white underline">{SITE.contact.phone}</a>
        · <a href="/what-we-treat" class="text-white underline">See what we treat</a>
      </p>
    </div>
  </section>
</BaseLayout>
