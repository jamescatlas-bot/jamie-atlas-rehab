---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const addr = SITE.contact.address;
const mapQuery = encodeURIComponent(`${addr.street}, ${addr.city}, ${addr.state} ${addr.zip}`);
---

<BaseLayout
  title="The Studio"
  description={`Private one-on-one rehabilitation studio at ${addr.street}, ${addr.level}, ${addr.city}, ${addr.state} ${addr.zip}. Location, parking, and contact details.`}
>
  <section class="px-6 pt-16 pb-12 md:pt-24">
    <div class="max-w-3xl mx-auto">
      <p class="font-serif italic text-[var(--color-primary)] mb-3 text-lg">The studio</p>
      <h1 class="mb-8">A private studio in downtown Denver</h1>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed">
        If the last place you did rehab had a waiting room, a shared floor and someone glancing over from the next
        table, this is not that. <strong class="text-[var(--color-text)]">No audience, no double-booking, no
        clock on the wall counting down from twelve.</strong> The hour is yours and so is the room.
      </p>
    </div>
  </section>

  <section class="px-6 py-16 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="mb-6">Find us</h2>
        <address class="not-italic text-lg text-[var(--color-text-muted)] leading-relaxed mb-8">
          <strong class="text-[var(--color-text)]">{SITE.name}</strong><br />
          {addr.street}, {addr.level}<br />
          {addr.city}, {addr.state} {addr.zip}
        </address>
        <ul class="space-y-3 text-lg">
          <li>
            <a href={`tel:${SITE.contact.phoneTel}`}>{SITE.contact.phone}</a>
            <span class="text-[var(--color-text-muted)]"> — call or text</span>
          </li>
          <li><a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a></li>
        </ul>

        <h3 class="mt-10 mb-4">Getting in</h3>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-6">
          The studio is on the basement level of {addr.street}, between 18th and 19th on Glenarm. Lift or stairs down
          one level, then follow the corridor around — you'll know the door when you see it.
          <strong class="text-[var(--color-text)]">First visit, just text me when you arrive and I'll come and get
          you.</strong> Nobody has ever found it first time without a small moment of doubt.
        </p>
        <div class="grid grid-cols-2 gap-4">
          <figure>
            <img
              src="/studio-building.jpg"
              alt={`The office tower at ${addr.street}, Denver — the studio is on the basement level`}
              width="607"
              height="547"
              loading="lazy"
              class="rounded-xl border border-[var(--color-border)] w-full h-56 object-cover"
            />
            <figcaption class="mt-2 text-base text-[var(--color-text-muted)]">
              1. This building, on the corner.
            </figcaption>
          </figure>
          <figure>
            <img
              src="/studio-entrance.jpg"
              alt="The studio door on the basement level, with the graffiti wall and client photos visible inside"
              width="1100"
              height="1375"
              loading="lazy"
              class="rounded-xl border border-[var(--color-border)] w-full h-56 object-cover"
            />
            <figcaption class="mt-2 text-base text-[var(--color-text-muted)]">
              2. This door, one level down.
            </figcaption>
          </figure>
        </div>

        <h3 class="mt-10 mb-4">Parking (read this — it's downtown)</h3>
        <ul class="space-y-3 text-lg text-[var(--color-text-muted)] leading-relaxed list-disc pl-5">
          <li>Metered street parking on Glenarm, California, and Welton — usually easiest before 9 AM and after 4 PM.</li>
          <li>Paid lots and garages within a block in every direction; budget $10–15 for a session.</li>
          <li>RTD: the D/H/L lines stop at 18th &amp; California, a 2-minute walk. Honestly the easiest option.</li>
        </ul>
      </div>

      <div>
        <div class="rounded-xl overflow-hidden border border-[var(--color-border)] h-80 md:h-full min-h-80">
          <iframe
            title={`Map to ${SITE.name}`}
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
            width="100%"
            height="100%"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-8">Inside the studio</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <img
          src="/studio-coaching.jpg"
          alt="Jamie Atlas coaching two clients through a movement assessment in the Denver studio"
          width="1400"
          height="718"
          loading="lazy"
          class="rounded-xl border border-[var(--color-border)] w-full h-full object-cover"
        />
        <img
          src="/studio-space.jpg"
          alt="A client working through a loaded hinge pattern in the Jamie Atlas Rehab studio"
          width="1100"
          height="1467"
          loading="lazy"
          class="rounded-xl border border-[var(--color-border)] w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <section class="px-6 pb-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-6">Hours</h2>
      <ul class="space-y-2 text-lg text-[var(--color-text-muted)]">
        <li>Monday – Friday: {SITE.hours.weekdays}</li>
        <li>Saturday: {SITE.hours.saturday}</li>
        <li>Sunday: {SITE.hours.sunday}</li>
      </ul>
      <p class="mt-6 text-lg text-[var(--color-text-muted)]">
        Sessions are by appointment. Telehealth available for clients outside the Denver metro.
      </p>
    </div>
  </section>

  <section class="px-6 py-20 bg-[var(--color-primary)] text-on-dark">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="mb-6 text-white">Come see it in person</h2>
      <p class="text-xl mb-10 opacity-95">The consultation happens at the studio — you'll know within 30 minutes if it's the right fit.</p>
      <a href="/book" class="cta-button cta-button-accent text-lg">Book a consultation</a>
    </div>
  </section>
</BaseLayout>
