---
// HOMEPAGE — Version E, approved by Jamie 2026-09-09. Spec: doc 70
// (70_HOMEPAGE_E_BUILD_HANDOFF.md). Mockup: Claude artifact "Three Homepages,
// Jamie Atlas", tab E.
//
// Shape: a three-door chooser in the fold (goal-worded, two quiet exits under
// it), then the fact band, a seasonal strip, three static client videos, the
// proof band, the studio with walk times, credibility, reviews, FAQ, final CTA.
//
// Rules baked in (do not undo):
//  - "best personal trainer" appears ONLY as 5280's award name, attributed
//    every time. Never a bare self-claim.
//  - No sliders or rotation anywhere (proof-placement decision, 23 Aug).
//  - No before/after photos in the hero; door 3 uses a training photo.
//  - Every client photo is from the consented "website ready" folder.
//  - NEVER public/studio-space.jpg (barefoot man, red shirt) — deleted.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { REVIEWS, GOOGLE_RATING, REVIEWS_URL } from '../data/reviews';
import { FEATURED_TESTIMONIALS } from '../data/videos';
import VideoCards from '../components/VideoCards.astro';
import StickyBook from '../components/StickyBook.astro';

import heroStudio from '../assets/home/hero-studio.jpg';
import doorSport from '../assets/home/door-sport.jpg';
import doorHurt from '../assets/home/door-hurt.jpg';
import doorMuscle from '../assets/home/door-muscle.jpg';
import portrait from '../assets/home/portrait.jpg';
import studioInside from '../assets/home/studio-inside.jpg';
import press9news from '../assets/home/press-9news.jpg';
import pressMayor from '../assets/home/press-mayor.jpg';

// Title tag: the award IS the search phrase, so it can sit here as a fact.
const title = 'Best Personal Trainer in Denver, 3× by 5280 Magazine | Jamie Atlas';

// The three doors (Jamie, 2026-09-09). Goals, not identities: a referral with
// a bad knee is one person, not two. Door 1 leads (decided 5 Sep).
// Door 3 → the GLP-1 page, exit 2 → the training hub (both built in doc 71).
const doors = [
  {
    tag: 'Most of what I do',
    h: 'I want to get better at my sport without getting hurt again.',
    p: "Ski, golf, run, lift, pickleball. Training built around the joint you're worried about.",
    href: '/this-is-you/worried-about-reinjury',
    img: doorSport,
    alt: 'A client doing a step-up in the downtown Denver studio, back to the camera, coached by Jamie Atlas, personal trainer',
    lead: true,
  },
  {
    tag: 'Second door',
    h: "I'm hurt and I want to get better.",
    p: 'The PT, the chiro, the injections. Where the system drops off is where we begin.',
    href: '/this-is-you/still-in-pain',
    img: doorHurt,
    alt: "Jamie Atlas, personal trainer and rehab specialist, assessing a client's ankle on a balance board at his downtown Denver studio",
    lead: false,
  },
  {
    tag: 'Third door',
    h: 'I want to lose the weight and keep the muscle.',
    p: 'On GLP-1 or not. Strength first, so what comes off is fat and what stays is you.',
    href: '/personal-trainer-denver/glp-1',
    img: doorMuscle,
    alt: 'A client in his sixties hinging with a kettlebell in front of the mural at the Denver studio',
    lead: false,
  },
];

// Walk times live in site.ts (verified by Jamie 9 Sep 2026) so the hub and
// /studio show the same numbers.
const walk = SITE.walkTimes;

const faq = [
  {
    q: 'Are you really the best personal trainer in Denver?',
    a: '5280 magazine said so three times, and I\'m grateful. The truer answer is that "best" depends on what you need. If you want someone to count reps at you, there are cheaper trainers within four blocks and I\'ll happily name two. If you want to train hard around a knee, a back or a shoulder that has a history, with the rehab and the nutrition coaching handled by the same person, that is the thing I\'m best at, and the reviews above are the evidence.',
  },
  {
    q: 'Is this a gym?',
    a: "No. It's a private studio, one client at a time, on the basement level of an office building downtown. Nobody is waiting for the squat rack.",
  },
  {
    q: "I've got a bad knee (back, shoulder). Can I still train?",
    a: 'That is most of who I train. The first visit is an assessment so we know what your body will accept today, and the program is built around that joint rather than around avoiding it.',
  },
  {
    q: 'Do I need a referral or insurance?',
    a: "No. Cash pay, no forms. I'm a personal trainer with rehab training, so nothing here goes through insurance.",
  },
  {
    q: 'What does the $57 assessment involve?',
    a: "Thirty minutes. Your story, a look at how you move, one change you can measure before you leave, and my plain read on whether I can help. If I can't, I'll tell you who can.",
  },
  {
    q: 'What if I work downtown and only have a lunch hour?',
    a: "Thirty-minute sessions exist for exactly that. Walk over, train, walk back. The 6:30am and 5:15pm slots are the other option, and they're open most weeks.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const videoSchema = FEATURED_TESTIMONIALS.map(v => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: v.title,
  description: v.bio ?? v.title,
  thumbnailUrl: `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`,
  uploadDate: v.uploadDate ?? '2026-08-05',
  contentUrl: `https://www.youtube.com/watch?v=${v.id}`,
  embedUrl: `https://www.youtube-nocookie.com/embed/${v.id}`,
  publisher: { '@id': SITE.url },
}));
---

<BaseLayout title={title} description={SITE.description} image="/jamie-portrait.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

  <div class="home-e">

    <!-- FOLD: who-line, greeting, keyword H1, three doors, two exits -->
    <section class="hero relative overflow-hidden text-white">
      <Image
        src={heroStudio}
        alt=""
        widths={[640, 1100, 1600]}
        sizes="100vw"
        format="webp"
        quality={70}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
      />
      <div class="hero-shade absolute inset-0" aria-hidden="true"></div>
      <div class="relative max-w-6xl mx-auto px-5 sm:px-6 pt-12 sm:pt-16 pb-10 sm:pb-12">
        <p class="who">
          <b>Jamie Atlas</b> · {SITE.awardBadge} · 9NEWS fitness expert
        </p>
        <p class="greet">Hi, glad you're here.<br />Which one of these is you?</p>
        <h1 class="kw">Named Denver's Best Personal Trainer three times by 5280 Magazine. Rehab specialist. Downtown.</h1>
        <p class="sub">
          Pick a door and I'll talk to you about your thing, not everybody's thing. Rehab and nutrition coaching come
          with every session, one client at a time, two blocks off the 16th Street Mall.
        </p>

        <div class="grid md:grid-cols-3 gap-3.5 mt-7">
          {doors.map(d => (
            <a href={d.href} class={`door group ${d.lead ? 'door-lead' : ''}`}>
              <Image
                src={d.img}
                alt={d.alt}
                widths={[480, 800]}
                sizes="(min-width: 768px) 33vw, 100vw"
                format="webp"
                quality={72}
                loading="eager"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
              <span class="door-shade absolute inset-0" aria-hidden="true"></span>
              <span class="relative block p-5">
                <span class="tag">{d.tag}</span>
                <span class="door-h">{d.h}</span>
                <span class="door-p">{d.p}</span>
              </span>
            </a>
          ))}
        </div>

        <div class="exits">
          <a href="/about">
            <Image src={portrait} alt="" width={68} height={68} format="webp" class="h-[34px] w-[34px] rounded-full object-cover border border-white/50" />
            Heard of Jamie? Tell me more before I decide. <span class="arrow">→</span>
          </a>
          <a href="/personal-trainer-denver">I'll have a look around myself. <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- FACT BAND: first thing on the first scroll -->
    <div class="facts">
      <div class="max-w-6xl mx-auto px-5 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-3">
        <div class="f">
          <span>{GOOGLE_RATING.stars.toFixed(1)} on Google, {GOOGLE_RATING.count} reviews</span>
          <span>$200 per 60-minute session</span>
          <span>6:30am and 5:15pm slots open most weeks</span>
          <span>{SITE.contact.address.street}, {SITE.contact.address.level}, {SITE.contact.address.city} {SITE.contact.address.state} {SITE.contact.address.zip}</span>
          <span><a href={`tel:${SITE.contact.phoneTel}`}>{SITE.contact.phone}</a>, call or text</span>
        </div>
        <a href="/book" class="btn-white">Book a 30-minute assessment · $57</a>
      </div>
    </div>

    <!-- SEASONAL STRIP: swap copy by season (ski now; golf in March; hiking in June) -->
    <div class="season">
      <div class="max-w-6xl mx-auto px-5 sm:px-6 py-3.5 flex flex-wrap items-center gap-2 sm:gap-5">
        <b>In season now</b>
        <span>Ski conditioning in Denver. Your first day on snow is the biggest leg day of your year.</span>
        <span class="flex-1"></span>
        <a href="/for/skiers">Get ready for the season →</a>
        <a href="/resources/ski-squats">The ski squat guide →</a>
      </div>
    </div>

    <!-- VIDEO PROOF: three static cards, no rotation -->
    <section class="vid">
      <div class="max-w-6xl mx-auto px-5 sm:px-6 py-14 sm:py-16">
        <h2>Watch pain change in real time</h2>
        <p class="intro">
          Real clients, on camera, before and after. One could be a fluke. Twenty-three is a pattern. Results vary from
          person to person.
        </p>
        <VideoCards videos={FEATURED_TESTIMONIALS} />
        <p class="more">Twenty more on the <a href="/testimonials">testimonials page</a>, sorted by body part.</p>
      </div>
    </section>

    <!-- PROOF BAND -->
    <div class="proof">
      <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4">
        <div><b>6×</b><span>5280 Top of the Town winner</span></div>
        <div><b>2×</b><span>Denver A-List winner</span></div>
        <div><b>9NEWS</b><span>The station's fitness expert · 25 years training Denver</span></div>
        <div><b>5.0</b><span>Google rating, {GOOGLE_RATING.count} reviews, all verbatim</span></div>
      </div>
      <div class="max-w-6xl mx-auto px-5 sm:px-6 logos">
        {SITE.PRESS_OUTLETS.map(o => (
          <img src={`/${o.file.replace('.png', '-white.png')}`} alt={o.name} loading="lazy" style={`height:${Math.round(o.h * 0.72)}px`} />
        ))}
      </div>
    </div>

    <!-- STUDIO + WALK TIMES -->
    <section class="studio grid md:grid-cols-2">
      <a href="/studio" class="block relative min-h-[320px] md:min-h-0" aria-label="See the studio at 1800 Glenarm Place">
        <Image
          src={studioInside}
          alt="The mural wall and training floor at Jamie Atlas Personal Training & Rehabilitation, 1800 Glenarm Place, downtown Denver"
          widths={[640, 1000]}
          sizes="(min-width: 768px) 50vw, 100vw"
          format="webp"
          quality={72}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </a>
      <div class="tx px-6 sm:px-12 py-12 sm:py-16">
        <h2>Not a gym. A room with one client in it.</h2>
        <p>
          Basement level, {SITE.contact.address.street}, two blocks off the 16th Street Mall. A rig, a reformer, a mural,
          and nobody waiting for your rack. Walk over, train, walk back before your 8am.
        </p>
        <ul class="walk">
          {walk.map(w => (
            <li><span>{w.from}</span><b>{w.time}</b></li>
          ))}
        </ul>
        <a href="/studio" class="see">See the studio, parking and how to find the door →</a>
      </div>
    </section>

    <!-- CREDIBILITY -->
    <section class="cred">
      <div class="max-w-6xl mx-auto px-5 sm:px-6 py-14 sm:py-16 grid md:grid-cols-[1.1fr_.9fr] gap-9 items-center">
        <div>
          <h2>You may already know this face</h2>
          <p>
            Jamie arrived from Sydney in 2001 and has trained Denver ever since: a few UFC, NFL, NBA and NHL athletes
            he isn't allowed to name, and a great many Coloradans who just wanted their knee back.
          </p>
          <p>
            Six 5280 Top of the Town honours and two Denver A-List wins in four years, one basement. The basement has
            been his since November 2010. Three of the 5280 ones say Best Personal Trainer in Denver on them.
          </p>
          <p>
            BSc Neuroscience (Australian National University). Cognitive Functional Therapy. Applied Functional Science,
            Gray Institute. NSCA-CSCS. NASM-CPT. Certificate IV in Nutrition Coaching.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <figure class="m-0">
            <Image src={press9news} alt="9NEWS on-air graphic: Jamie Atlas, fitness expert, Denver" widths={[460, 920]} sizes="25vw" format="webp" loading="lazy" class="rounded-lg border border-white/10" />
            <figcaption>9NEWS, the fitness expert segment.</figcaption>
          </figure>
          <figure class="m-0">
            <Image src={pressMayor} alt="Jamie Atlas on stage at a LiveWell Colorado event in Denver with the Mayor" widths={[460, 920]} sizes="25vw" format="webp" loading="lazy" class="rounded-lg border border-white/10" />
            <figcaption>LiveWell Colorado, on stage with the Mayor.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- REVIEWS: three, static -->
    <section class="reviews">
      <div class="max-w-6xl mx-auto px-5 sm:px-6 py-14 sm:py-16">
        <h2>Rated {GOOGLE_RATING.stars.toFixed(1)} on Google, {GOOGLE_RATING.count} reviews</h2>
        <p class="intro">Verbatim, verifiable, unpaid.</p>
        <div class="grid md:grid-cols-3 gap-4 mt-7">
          {REVIEWS.map(r => (
            <blockquote>
              <span class="stars" aria-label="Five stars">★★★★★</span>
              "{r.text}"
              <footer>{r.name}</footer>
            </blockquote>
          ))}
        </div>
        <p class="more"><a href="/reviews">More client reviews</a> · <a href={REVIEWS_URL} rel="noopener">See all {GOOGLE_RATING.count} on Google</a></p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq">
      <div class="max-w-6xl mx-auto px-5 sm:px-6 py-14 sm:py-16">
        <h2>Things people ask before they book</h2>
        <div class="mt-6">
          {faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final">
      <div class="max-w-3xl mx-auto px-5 sm:px-6 py-16 sm:py-20 text-center">
        <h2>Thirty minutes. One measurable change. Then you decide.</h2>
        <p>
          A 30-minute assessment, $57, in the studio or on Zoom. If it's not a fit I'll say so in the first half hour,
          and I'll know who is.
        </p>
        <a href="/book" class="cta-button text-lg">Book a 30-minute assessment</a>
        <p class="nap">
          {SITE.contact.address.street}, {SITE.contact.address.level} · <a href={`tel:${SITE.contact.phoneTel}`}>{SITE.contact.phone}</a> · Mon to Fri {SITE.hours.weekdays} · Sat {SITE.hours.saturday}
        </p>
      </div>
    </section>

  </div>

  <StickyBook />
</BaseLayout>

<style>
  /* Version E lives in its own dark world; the shared header and footer stay
     as they are on every other page. Palette from the brand guide: Navy Ink
     #0B2E45, near-black #0B1620, Atlas Blue #0079C2, Signal Orange #F5921E,
     Award Red #B91D2B (5280 only). */
  .home-e {
    --navy: #0b1620;
    --deep: #0b2e45;
    --blue: #0079c2;
    --sky: #7cc4f0;
    --orange: #f5921e;
    --ink: #eef3f7;
    --muted: #d5e2ec;
    --soft: #a9bccb;
    background: var(--navy);
    color: var(--ink);
    font-family: 'Inter', -apple-system, 'Segoe UI', sans-serif;
  }
  .home-e h1, .home-e h2, .home-e h3 {
    font-family: 'Barlow Semi Condensed', 'Inter', sans-serif;
    letter-spacing: 0.005em;
    color: #fff;
  }
  .home-e h2 { font-size: clamp(30px, 4.4vw, 52px); line-height: 1; margin-bottom: 12px; }
  .home-e .intro { color: var(--soft); font-size: 18px; max-width: 58ch; }
  .home-e .more { margin-top: 20px; font-size: 15px; color: var(--soft); }
  .home-e .more a { color: #fff; }

  /* fold */
  .hero { background: var(--deep); }
  .hero-shade { background: linear-gradient(180deg, rgba(11,22,32,.45) 0%, rgba(11,22,32,.6) 45%, rgba(11,22,32,.96) 100%); }
  .who { font-size: 12.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--sky); margin-bottom: 14px; }
  .who b { color: #fff; }
  .greet { font-family: 'Barlow Semi Condensed', 'Inter', sans-serif; font-weight: 700; font-size: clamp(34px, 5vw, 60px); line-height: .98; color: #fff; margin-bottom: 10px; text-wrap: balance; }
  .kw { font-size: clamp(20px, 2.4vw, 28px); font-weight: 600; color: var(--sky); line-height: 1.2; margin-bottom: 6px; text-wrap: balance; }
  .sub { color: var(--muted); font-size: 17px; max-width: 58ch; }

  .door { position: relative; display: flex; align-items: flex-end; min-height: 300px; border-radius: 12px; overflow: hidden; background: #172230; color: #fff; text-decoration: none; }
  .door-lead { outline: 2px solid var(--blue); outline-offset: -2px; }
  .door-shade { background: linear-gradient(180deg, rgba(11,22,32,0) 30%, rgba(11,22,32,.92) 100%); }
  .door .tag { display: block; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); font-weight: 700; margin-bottom: 6px; }
  .door-h { display: block; font-family: 'Barlow Semi Condensed', 'Inter', sans-serif; font-weight: 700; font-size: 23px; line-height: 1.08; margin-bottom: 6px; }
  .door-p { display: block; font-size: 15px; color: var(--muted); }

  .exits { display: flex; flex-wrap: wrap; gap: 10px 28px; align-items: center; margin-top: 22px; font-size: 15px; }
  .exits a { color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; gap: 10px; border-bottom: 1px solid rgba(255,255,255,.35); padding-bottom: 2px; }
  .exits a:hover { color: #fff; border-bottom-color: #fff; }
  .exits .arrow { color: var(--orange); }

  /* fact band */
  .facts { background: var(--blue); color: #fff; }
  .facts .f { display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 14.5px; font-weight: 600; }
  .facts .f span::before { content: ""; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--orange); margin-right: 8px; vertical-align: 1px; }
  .facts a { color: #fff; text-decoration-color: rgba(255,255,255,.5); }
  .btn-white { display: inline-block; background: #fff; color: var(--navy) !important; font-weight: 700; padding: 12px 20px; border-radius: 8px; text-decoration: none; white-space: nowrap; font-size: 15px; }
  .btn-white:hover { background: #ecf6fd; }

  /* seasonal strip */
  .season { background: var(--orange); color: #14202b; font-size: 15.5px; }
  .season b { font-family: 'Barlow Semi Condensed', 'Inter', sans-serif; font-size: 18px; letter-spacing: .04em; text-transform: uppercase; font-weight: 800; }
  .season a { color: #14202b; font-weight: 700; text-underline-offset: 3px; }

  .vid { background: #0e1c28; }

  /* proof band */
  .proof { background: var(--blue); color: #fff; }
  .proof > div:first-child > div { padding: 22px 18px; border-right: 1px solid rgba(255,255,255,.22); }
  .proof > div:first-child > div:last-child { border-right: 0; }
  .proof b { display: block; font-family: 'Barlow Semi Condensed', 'Inter', sans-serif; font-size: 34px; line-height: 1; font-weight: 800; }
  .proof span { display: block; font-size: 13.5px; color: #d5ebfa; margin-top: 6px; }
  .logos { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 18px 40px; padding: 22px 24px 14px; border-top: 1px solid rgba(255,255,255,.2); }
  .logos img { width: auto; opacity: .9; }

  /* studio */
  .studio .tx { background: var(--deep); display: flex; flex-direction: column; justify-content: center; }
  .studio .tx p { color: var(--muted); font-size: 18px; max-width: 44ch; margin-bottom: 14px; }
  .walk { list-style: none; padding: 0; margin: 18px 0 0; border-top: 1px solid rgba(255,255,255,.15); }
  .walk li { display: flex; justify-content: space-between; gap: 14px; padding: 9px 0; border-bottom: 1px solid rgba(255,255,255,.15); font-size: 15px; color: var(--muted); }
  .walk li b { color: #fff; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .see { display: inline-block; margin-top: 18px; color: var(--sky); font-weight: 700; text-decoration: none; border-bottom: 1px solid var(--sky); }

  /* credibility */
  .cred p { color: var(--muted); font-size: 18px; margin-bottom: 14px; max-width: 52ch; }
  .cred figcaption { font-size: 12.5px; color: var(--soft); margin-top: 6px; }

  /* reviews */
  .reviews { background: #0e1c28; }
  .reviews blockquote { margin: 0; background: #172230; border-radius: 10px; padding: 22px 20px; font-size: 16px; color: var(--muted); border-top: 3px solid var(--orange); }
  .reviews blockquote footer { margin-top: 12px; font-size: 13.5px; color: #fff; font-weight: 700; }
  .stars { color: var(--orange); letter-spacing: 2px; font-size: 14px; display: block; margin-bottom: 8px; }

  /* faq */
  .faq { background: var(--deep); }
  .faq details { border-top: 1px solid rgba(255,255,255,.18); padding: 14px 0; }
  .faq details:last-of-type { border-bottom: 1px solid rgba(255,255,255,.18); }
  .faq summary { font-family: 'Barlow Semi Condensed', 'Inter', sans-serif; font-weight: 700; font-size: 20px; color: #fff; cursor: pointer; }
  .faq details p { margin-top: 8px; color: var(--muted); max-width: 66ch; font-size: 16px; }

  /* final */
  .final { background: #fff; color: var(--navy); }
  .final h2 { color: var(--navy); }
  .final p { color: #3d4b58; font-size: 18px; max-width: 54ch; margin: 0 auto 24px; }
  .final .nap { font-size: 14.5px; font-weight: 600; color: var(--deep); margin-top: 22px; }
  .final .nap a { color: var(--deep); }
</style>
