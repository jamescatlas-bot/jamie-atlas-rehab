---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { REVIEWS, GOOGLE_RATING, REVIEWS_URL } from '../data/reviews';
import { FEATURED_TESTIMONIALS, TESTIMONIAL_VIDEOS } from '../data/videos';
import VideoTestimonial from '../components/VideoTestimonial.astro';
import PressStrip from '../components/PressStrip.astro';

// Homepage structure decided with Jamie 2026-08-06:
//  1. Hero names all THREE client segments (hurt-and-lost / cleared-but-not-
//     ready / train-without-reinjury) — see memory: niche_post_surgical_rts.
//  2. Video proof moves to position 2. His in-person close is "show one video,
//     they say wow, show two more" — the page now does that before asking the
//     visitor to read anything long. See memory: video_proof_loop.
//  3. Credibility = 6× 5280 Top of the Town + 3 years as 9NEWS fitness expert.
//     The Lancet section is DEMOTED to one linking line — regular humans don't
//     know or care about the Lancet. See memory: credibility_hierarchy.

// Count of pain-change clips. Deliberately excludes the Tom H. lead
// testimonial — it's a lifestyle interview, not a before/after pain demo, and
// Jamie's own count of "every video shows a result" is these 23.
const clipCount = TESTIMONIAL_VIDEOS.length;

// The three doors — headings and sublines are Jamie's own words (2026-08-06),
// in his order: cleared-but-not-ready LEFT, still-in-pain MIDDLE, reinjury RIGHT.
// 2026-08-08: reframed as explicit "click here if this is you"; new blue lines
// are Jamie's words verbatim.
const doors = [
  {
    title: 'Cleared by your PT but still not ready for sport/life',
    body: "<strong>No plan ever worked without first understanding where you've been and what you're going through.</strong>",
    cta: 'For when you need the next level of training — but safely',
    href: '/what-we-treat/post-surgical-return-to-sport',
  },
  {
    title: "You've tried everything and you're still in pain",
    body: '<strong>The system sometimes lets us down. Where it drops off is where we begin.</strong>',
    cta: "It's not your fault — your body might just need a different approach than you've tried already",
    href: '#pick-the-part',
  },
  {
    title: "You want to work out but you're worried about reinjuring your body",
    body: "<strong>It's our job to personalize your exercises to set you up for success.</strong>",
    cta: "It's not your job to know which workouts are best for your body — it's mine",
    href: '/what-we-treat/masters-athlete-injuries',
  },
];

// Box copy + joint illustrations are Jamie's, 2026-08-08 (images from his
// reference file, cropped per joint; knee square-cropped to keep pain burst).
const byArea = [
  {
    title: 'Back Pain & Sciatica',
    slug: '/what-we-treat/chronic-back-pain',
    body: "You never realize how much you use your low back for everything until it's hurt. This method starts with finding the exercises you can do free of pain.",
    img: '/joints/back.webp',
    alt: 'Illustration of the lumbar spine and pelvis with pain signals at the low back',
    also: { label: 'Pain running down your leg? Sciatica →', slug: '/what-we-treat/sciatica' },
  },
  {
    title: 'Neck Pain',
    slug: '/what-we-treat/neck-pain',
    body: "Stiffness, pain turning and trouble focusing. Headaches. There are 3 different factors that affect your neck pain that most treatment misses. Knowing how to solve them all? That's our business.",
    img: '/joints/neck.webp',
    alt: 'Illustration of the skull and cervical spine with pain signals at the neck',
  },
  {
    title: 'Shoulder Pain',
    slug: '/what-we-treat/shoulder-pain',
    body: "It can come on suddenly — trouble picking up a cup, getting the shopping out or sleeping in a strange position. When a shoulder is hurt the best thing to do is the right movements. The worst thing to do is the wrong movements. Our job is knowing the difference.",
    img: '/joints/shoulder.webp',
    alt: 'Illustration of the shoulder joint with pain highlighted at the ball and socket',
  },
  {
    title: 'Knee Pain',
    slug: '/what-we-treat/knee-pain',
    body: "It starts innocently enough. Discomfort getting up from a chair. The descent from a hike leaving you hobbled. The phrase 'bone-on-bone' from your doctor. It would be understandable that you're confused. We're here to help you make sense of what you've been missing.",
    img: '/joints/knee.webp',
    alt: 'Illustration of the knee joint with pain signals at the kneecap',
  },
];

// Numbers corrected by Jamie 2026-08-06: FIVE 5280 wins (not six), and he is
// STILL the 9NEWS fitness expert — present tense, no year count on it.
const credentials = [
  {
    stat: '5×',
    label: '5280 Top of the Town winner',
    detail: "Voted one of Denver's best five times in 5280 Magazine's annual Top of the Town awards.",
  },
  {
    stat: '9NEWS',
    label: 'Fitness Expert',
    detail: "The on-air fitness expert for Denver's biggest news station. You may already know this face.",
  },
  {
    stat: '20+ yrs',
    label: 'Helping Coloradans move and perform at their best',
    detail: "Jamie arrived in 2001 after working at the Sydney Olympics. He's been helping every Coloradan looking for recovery, rehabilitation, or an edge over their competition — from recreational youth athletes to UFC, NFL, NBA and NHL athletes.",
  },
];

// Updated to Jamie's wording 2026-08-08 (45–60 min; twenty years).
const differentiators = [
  'One-on-one, every session. Never a class, never shared with three other people',
  '45–60 minutes, because that is genuinely what the work takes',
  "Built around your body's history, present and future goals — not a generic printed piece of paper with faceless figures",
  'Your rehabilitation program, nutrition, performance, at-home plans and workouts are all kept in house. No handoffs, no confusion, only results',
  'Twenty years of coaching, plus the pain science most providers were never taught',
  "We're not here to hold you back from getting results. If we can't help you, we'll recommend the right person who can",
];
---

<BaseLayout
  title="Denver Pain Relief & Return-to-Sport Rehab | Jamie Atlas"
  description={SITE.description}
>

  <!-- HERO -->
  <section class="px-6 pt-16 pb-16 md:pt-24 md:pb-20">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="mb-6">
        Get out of pain.<br />
        Get your body back.
      </h1>
      <!-- Subline + three bullets are Jamie's wording, 2026-08-07 -->
      <p class="text-xl md:text-2xl text-[var(--color-text-muted)] max-w-3xl mx-auto mb-5 leading-snug">
        A specialty rehabilitation &amp; sports performance studio in downtown Denver
        — for when you're:
      </p>
      <ul class="inline-block text-left list-disc pl-6 marker:text-[var(--color-primary)] text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed mb-7 space-y-1">
        <li>hurt and out of answers</li>
        <li>cleared by your therapist but don't feel ready to return</li>
        <li>looking for a training program that won't aggravate your injuries</li>
      </ul>
      <p class="text-base font-semibold text-[var(--color-primary)] mb-9">
        <span class="block">5× 5280 Top of the Town winner</span>
        <span class="block mt-1">9NEWS Fitness Expert</span>
      </p>
      <a href="/book" class="cta-button text-lg">
        Book a 30-minute consultation
      </a>
    </div>

    <div class="mt-12">
      <PressStrip compact={true} />
    </div>
  </section>

  <!-- PROOF FIRST: the in-person close ("watch this") is now the page's second beat -->
  <section class="px-6 py-20 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <p class="font-serif italic text-[var(--color-primary)] mb-3 text-lg">Don't take our word for anything</p>
        <h2 class="mb-6">Watch pain change in real time</h2>
        <!-- Intro copy is Jamie's own words, 2026-08-06 -->
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-5">
          Real clients, on camera, sharing the pain they are in before and after.
          Your results may vary, but their results (and reactions) are 100% genuine.
          When pain persists, sometimes the answer is more than just telling you to
          "breathe through it." When utilizing other neuroscience-based systems as part
          of a tolerable-movement integrated program, sometimes pain turns out to be changeable.
        </p>
        <p class="text-lg text-[var(--color-text)] font-semibold mb-6">
          The videos below are examples of what's possible.
        </p>
        <p class="text-lg leading-relaxed">
          There are {clipCount} of these videos on this site.<br />
          One video is luck.<br />
          <strong class="text-[var(--color-primary)]">{clipCount} shows a pattern of results you might not have thought possible.</strong>
        </p>
      </div>

      <div class="grid gap-14">
        {FEATURED_TESTIMONIALS.map(v => <VideoTestimonial video={v} />)}
      </div>

      <p class="text-center mt-12">
        <a href="/testimonials" class="font-semibold">Watch more — all {clipCount}, sorted by body part →</a>
      </p>
    </div>
  </section>

  <!-- THE THREE DOORS -->
  <section class="px-6 py-24">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-center mb-6">Three kinds of people walk in here</h2>
      <p class="text-center text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto mb-14 leading-relaxed">
        Most of them have already been somewhere else. Often several somewheres.
        <strong class="text-[var(--color-text)]">We get it.</strong> Find yourself below.
      </p>
      <div class="grid md:grid-cols-3 gap-6">
        {doors.map(d => (
          <a
            href={d.href}
            class="flex flex-col p-7 border-2 border-[var(--color-border)] rounded-xl bg-[var(--color-surface)] hover:border-[var(--color-primary)] hover:shadow-md transition-all no-underline"
          >
            <span class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent-dark)] mb-3">Click here if this is you</span>
            <h3 class="mb-4 text-[var(--color-primary)]">{d.title}</h3>
            <p class="text-[var(--color-text-muted)] leading-relaxed mb-6" set:html={d.body} />
            <span class="mt-auto font-semibold text-[var(--color-primary)]">{d.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PICK THE PART (door 1 lands here) -->
  <section id="pick-the-part" class="px-6 py-24 bg-[var(--color-surface)] border-y border-[var(--color-border)] scroll-mt-20">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-center mb-4">Pick the part that's stopping you</h2>
      <p class="text-center text-[var(--color-text-muted)] max-w-2xl mx-auto mb-14">
        Same method behind all four — what changes is what we find driving it.
        Each page has client videos for that body part.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {byArea.map(c => (
          <div class="p-7 border border-[var(--color-border)] rounded-xl bg-[var(--color-background)] hover:border-[var(--color-primary)] transition-all">
            <div class="flex items-start justify-between gap-4 mb-3">
              <h3 class="mb-0">
                <a href={c.slug} class="text-[var(--color-primary)] no-underline">{c.title}</a>
              </h3>
              <a href={c.slug} aria-hidden="true" tabindex="-1" class="flex-shrink-0">
                <img src={c.img} alt={c.alt} width="320" height="320" loading="lazy"
                  class="w-24 h-24 md:w-28 md:h-28 rounded-lg" />
              </a>
            </div>
            <p class="text-[var(--color-text-muted)] text-base leading-relaxed">{c.body}</p>
            {c.also && (
              <p class="mt-4 text-sm"><a href={c.also.slug}>{c.also.label}</a></p>
            )}
          </div>
        ))}
      </div>

      <!-- CFT closing line removed at Jamie's request 2026-08-08; the CFT
           mention (with descriptor) in the credibility section remains. -->
    </div>
  </section>

  <!-- CREDIBILITY: local standing first; the science gets one linking line -->
  <section class="px-6 py-24">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-center mb-14">You may already know this studio</h2>
      <div class="grid md:grid-cols-3 gap-10 md:gap-12 text-center">
        {credentials.map(c => (
          <div>
            <p class="font-serif font-bold text-5xl text-[var(--color-primary)] mb-2">{c.stat}</p>
            <h3 class="mb-3">{c.label}</h3>
            <p class="text-[var(--color-text-muted)] leading-relaxed">{c.detail}</p>
          </div>
        ))}
      </div>
      <p class="text-center mt-14 text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
        All of it under one roof:
        <strong class="text-[var(--color-text)]">Jamie Atlas, Pain &amp; Performance Specialist</strong>
        — certified in Cognitive Functional Therapy, a method for retraining how your
        body and nervous system respond to pain.
        <a href="/what-we-treat/cognitive-functional-therapy">How it works →</a>
      </p>
    </div>
  </section>

  <!-- HOW IT'S DIFFERENT -->
  <section class="px-6 py-24 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-center mb-14">How this is different from what you've tried</h2>
      <ul class="space-y-5">
        {differentiators.map(d => (
          <li class="flex items-start gap-4">
            <span class="text-[var(--color-primary)] text-2xl leading-none mt-1 flex-shrink-0">✓</span>
            <span class="text-lg leading-snug">{d}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="px-6 py-24">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-center mb-4">Rated {GOOGLE_RATING.stars.toFixed(1)} on Google</h2>
      <p class="text-center text-[var(--color-text-muted)] mb-14">Verbatim, verifiable, unpaid.</p>
<!-- Rotating review wheel (Jamie, 2026-08-06): one review at a time, advances
     every 7 seconds. Plain inline JS, no library — zero page-speed cost.
     Pauses on hover, stops entirely for reduced-motion users, and shows the
     first review statically if JavaScript is off. -->
      <div id="review-wheel" class="relative max-w-2xl mx-auto min-h-[13rem] sm:min-h-[11rem]">
        {REVIEWS.map((r, i) => (
          <blockquote
            class={`review-slide border-l-4 border-[var(--color-primary)] pl-5 absolute inset-x-0 top-0 transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}
            data-slide={i}
          >
            <p class="leading-relaxed mb-3 text-lg">"{r.text}"</p>
            <footer class="text-sm text-[var(--color-text-muted)]">— {r.name}</footer>
          </blockquote>
        ))}
      </div>
      <div class="flex justify-center gap-2.5 mt-6" id="review-dots" aria-hidden="true">
        {REVIEWS.map((_, i) => (
          <button
            class={`review-dot w-2.5 h-2.5 rounded-full border-0 p-0 cursor-pointer transition-colors ${i === 0 ? 'bg-[var(--color-primary)]' : 'bg-[var(--color-border)]'}`}
            data-dot={i}
            aria-label={`Show review ${i + 1}`}
          ></button>
        ))}
      </div>

      <script is:inline>
        (function () {
          var slides = document.querySelectorAll('.review-slide');
          var dots = document.querySelectorAll('.review-dot');
          if (slides.length < 2) return;
          var current = 0;
          var paused = false;
          var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          function show(i) {
            slides[current].classList.remove('opacity-100');
            slides[current].classList.add('opacity-0', 'pointer-events-none');
            dots[current].style.background = 'var(--color-border)';
            current = i;
            slides[current].classList.remove('opacity-0', 'pointer-events-none');
            slides[current].classList.add('opacity-100');
            dots[current].style.background = 'var(--color-primary)';
          }

          dots.forEach(function (d) {
            d.addEventListener('click', function () { show(+d.dataset.dot); });
          });

          var wheel = document.getElementById('review-wheel');
          wheel.addEventListener('mouseenter', function () { paused = true; });
          wheel.addEventListener('mouseleave', function () { paused = false; });

          if (!reduced) {
            setInterval(function () {
              if (!paused) show((current + 1) % slides.length);
            }, 7000);
          }
        })();
      </script>

      <p class="text-center mt-12">
        <a href="/reviews" class="font-semibold">More client reviews →</a>
        <span class="text-[var(--color-text-muted)] px-2">·</span>
        <a href={REVIEWS_URL}>See all {GOOGLE_RATING.count} on Google</a>
      </p>
    </div>
  </section>

  <!-- STUDIO PHOTO — proof of place, just before the ask -->
  <section class="px-6 pb-4">
    <div class="max-w-5xl mx-auto">
      <img
        src="/studio-coaching.jpg"
        alt="Jamie Atlas coaching two clients through a movement assessment at his downtown Denver studio"
        width="1400"
        height="718"
        loading="lazy"
        class="rounded-2xl border border-[var(--color-border)] w-full"
      />
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="px-6 py-24 bg-[var(--color-primary)] text-on-dark">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="mb-6 text-white">Stop waiting for the pain to go away on its own</h2>
      <p class="text-xl mb-10 opacity-95">
        A 30-minute consultation tells you whether this is the right fit. No pressure, no insurance forms.
      </p>
      <a href="/book" class="cta-button cta-button-accent text-lg">
        Book a consultation
      </a>
      <p class="mt-8 text-sm opacity-80">
        Or call <a href={`tel:${SITE.contact.phoneTel}`} class="text-white underline">{SITE.contact.phone}</a>
      </p>
    </div>
  </section>

</BaseLayout>
