---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { REVIEWS, GOOGLE_RATING, REVIEWS_URL } from '../data/reviews';

const problems = [
  {
    title: 'Your PT ran out before you were better',
    body: "Insurance capped your sessions at 12. Your physical therapist discharged you. You're still not back to your sport — and the gap is exactly where we work.",
  },
  {
    title: 'The pain keeps coming back',
    body: "You've tried PT, chiropractic, injections. The pain comes back the moment you try to do what you actually love. That's a nervous-system problem, not a tissue problem.",
  },
  {
    title: "Cleared, but scared to move",
    body: "Your surgeon says you're fine. Your body says otherwise. You're scared to load the joint that took you out. The fix is graded exposure — done right.",
  },
];

const conditions = [
  {
    title: 'Post-Surgical Return-to-Sport',
    slug: '/what-we-treat/post-surgical-return-to-sport',
    body: 'When insurance PT ends but you\'re still not back on the bike, the slopes, or in the gym. The 9-month rebuild your surgeon doesn\'t tell you about.',
  },
  {
    title: 'Chronic Back Pain',
    slug: '/what-we-treat/chronic-back-pain',
    body: "When traditional PT, chiropractic, and injections haven't worked. Cognitive Functional Therapy — the approach validated in the 2023 Lancet RESTORE trial.",
  },
  {
    title: 'Persistent Sciatica',
    slug: '/what-we-treat/sciatica',
    body: "Radicular leg pain that didn't respond to chiropractic, epidural injections, or short-course physical therapy. Address the nervous-system component most providers miss.",
  },
  {
    title: 'Masters Athlete Injuries',
    slug: '/what-we-treat/masters-athlete-injuries',
    body: 'For runners, cyclists, skiers, and lifters 40+. Break out of the recurring injury cycle and stay in your sport for the next 20 years.',
  },
  {
    title: 'Cognitive Functional Therapy',
    slug: '/what-we-treat/cognitive-functional-therapy',
    body: "The evidence-based approach to chronic pain that most providers don't know — and that most patients with persistent pain need.",
  },
];

const differentiators = [
  '1-on-1 sessions, never group classes',
  '60–90 minute sessions, not the 12-minute insurance rush',
  'Programs designed around your sport — not a generic protocol',
  'Your strength coach is also your therapist — no handoffs, no contradictions',
  '30 years of progressive coaching experience plus current pain science',
  'No insurance billing, no productivity quotas, no rushed discharge',
];
---

<BaseLayout
  title="Denver Pain Relief & Return-to-Sport Rehab | Jamie Atlas"
  description={SITE.description}
>

  <!-- HERO -->
  <section class="px-6 pt-16 pb-20 md:pt-28 md:pb-28">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="mb-6">
        Get out of chronic pain.<br />
        Get back to your sport.
      </h1>
      <p class="text-xl md:text-2xl text-[var(--color-text-muted)] max-w-2xl mx-auto mb-10 leading-snug">
        Cognitive Functional Therapy + 30 years of strength coaching, for Denver adults 40+ who refuse to slow down.
      </p>
      <a href="/book" class="cta-button text-lg">
        Book a 30-minute consultation
      </a>
      <p class="mt-10 text-sm text-[var(--color-text-muted)]">
        Featured on <span class="font-semibold text-[var(--color-text)]">9News</span>
        ·
        <span class="font-semibold text-[var(--color-text)]">Denver Post</span>
        ·
        <span class="font-semibold text-[var(--color-text)]">UPWARD Women</span>
      </p>
    </div>

    <div class="max-w-5xl mx-auto mt-16 px-0">
      <img
        src="/studio-coaching.jpg"
        alt="Jamie Atlas coaching two clients through a movement assessment at his downtown Denver studio"
        width="1400"
        height="718"
        fetchpriority="high"
        class="rounded-2xl border border-[var(--color-border)] w-full"
      />
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="px-6 py-20 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-center mb-14">If any of this sounds familiar, you're in the right place</h2>
      <div class="grid md:grid-cols-3 gap-10 md:gap-12">
        {problems.map(p => (
          <div>
            <h3 class="mb-4">{p.title}</h3>
            <p class="text-[var(--color-text-muted)]">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE LANCET CREDIBILITY HAMMER -->
  <section class="px-6 py-24">
    <div class="max-w-3xl mx-auto text-center">
      <p class="font-serif italic text-[var(--color-primary)] mb-3 text-lg">The evidence</p>
      <h2 class="mb-8">Backed by science most therapists don't know</h2>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] mb-6 leading-relaxed">
        Cognitive Functional Therapy — the approach validated in the <strong class="text-[var(--color-text)]">2023 Lancet RESTORE trial</strong> and the 2025 three-year follow-up — produces large, durable effects for chronic back pain compared with usual care.
      </p>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed">
        I combine that approach with three decades of progressive strength coaching to do what most physical therapists can't: get you out of pain <em>and</em> back to your sport — without re-injury.
      </p>
    </div>
  </section>

  <!-- WHAT WE TREAT -->
  <section class="px-6 py-24 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-center mb-14">What we treat</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {conditions.map(c => (
          <a
            href={c.slug}
            class="block p-7 border border-[var(--color-border)] rounded-xl bg-[var(--color-background)] hover:border-[var(--color-primary)] hover:shadow-sm transition-all no-underline"
          >
            <h3 class="mb-3 text-[var(--color-primary)]">{c.title}</h3>
            <p class="text-[var(--color-text-muted)] text-base leading-relaxed">{c.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT'S DIFFERENT -->
  <section class="px-6 py-24">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-center mb-14">How this is different from what you've tried</h2>
      <ul class="space-y-5">
        {differentiators.map(d => (
          <li class="flex items-start gap-4">
            <span class="text-[var(--color-primary)] text-2xl leading-none mt-1 flex-shrink-0">✓</span>
            <span class="text-lg leading-snug">{d}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="px-6 py-24 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-center mb-4">Rated {GOOGLE_RATING.stars.toFixed(1)} on Google</h2>
      <p class="text-center text-[var(--color-text-muted)] mb-14">Verbatim, verifiable, unpaid.</p>
      <div class="grid md:grid-cols-3 gap-8">
        {REVIEWS.slice(0, 3).map(r => (
          <blockquote class="border-l-4 border-[var(--color-primary)] pl-5">
            <p class="leading-relaxed mb-3">"{r.text}"</p>
            <footer class="text-sm text-[var(--color-text-muted)]">— {r.name}</footer>
          </blockquote>
        ))}
      </div>
      <p class="text-center mt-12">
        <a href="/reviews" class="font-semibold">More client reviews →</a>
        <span class="text-[var(--color-text-muted)] px-2">·</span>
        <a href={REVIEWS_URL}>See all {GOOGLE_RATING.count} on Google</a>
      </p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="px-6 py-24 bg-[var(--color-primary)] text-on-dark">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="mb-6 text-white">Stop waiting for the pain to go away on its own</h2>
      <p class="text-xl mb-10 opacity-95">
        A 30-minute consultation tells you whether this is the right fit. No pressure, no insurance forms.
      </p>
      <a href="/book" class="cta-button cta-button-accent text-lg">
        Book a consultation
      </a>
      <p class="mt-8 text-sm opacity-80">
        Or call <a href={`tel:${SITE.contact.phoneTel}`} class="text-white underline">{SITE.contact.phone}</a>
      </p>
    </div>
  </section>

</BaseLayout>
