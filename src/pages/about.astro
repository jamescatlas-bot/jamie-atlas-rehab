---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jamie Atlas',
  jobTitle: 'Rehabilitation Specialist & Strength Coach',
  worksFor: { '@type': 'MedicalBusiness', name: SITE.name, url: SITE.url },
  url: `${SITE.url}/about`,
  email: SITE.contact.email,
  telephone: SITE.contact.phone,
  sameAs: [SITE.social.instagramUrl],
  knowsAbout: ['Cognitive Functional Therapy', 'Chronic pain rehabilitation', 'Strength and conditioning', 'Return-to-sport training'],
  hasCredential: SITE.credentials.map(c => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.name,
  })),
};
---

<BaseLayout
  title="About Jamie Atlas"
  description="Jamie Atlas: BSc Neuroscience, 30 years of strength coaching, Cognitive Functional Therapy practitioner in Denver. The story behind the method."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <section class="px-6 pt-16 pb-12 md:pt-24">
    <div class="max-w-3xl mx-auto">
      <p class="font-serif italic text-[var(--color-primary)] mb-3 text-lg">About</p>
      <h1 class="mb-8">Thirty years of learning why bodies hurt — and how they heal</h1>
    </div>
  </section>

  <section class="px-6 pb-20">
    <div class="max-w-3xl mx-auto space-y-6 text-lg text-[var(--color-text-muted)] leading-relaxed">
      <img
        src="/jamie-portrait.jpg"
        alt="Jamie Atlas, Cognitive Functional Therapist and strength coach in Denver"
        width="900"
        height="900"
        loading="lazy"
        class="rounded-xl border border-[var(--color-border)] w-44 md:w-56 float-right ml-6 mb-4"
      />
      <p>
        I grew up in Australia and studied neuroscience at the University of Western Australia, because I wanted to
        know how the brain drives the body. Then I spent thirty years finding out how much of that survives contact
        with an actual person in actual pain.
      </p>
      <p>
        <strong class="text-[var(--color-text)]">Not as much as the textbook implied.</strong> I started as a
        strength coach and trained everyone — elite athletes, and people walking into a gym for the first time six
        weeks after an operation. And I kept hitting the same wall from a different angle every time: someone who
        had been treated. Discharged from PT. Cleared by a surgeon. Adjusted, injected, imaged. Still in pain, still
        wary of moving, still nowhere near the life they came in wanting.
      </p>
      <p>
        Nobody had done anything wrong. They had each pulled on one thread of something that turned out to be a web.
      </p>
      <p>
        That wall is what took me to
        <strong class="text-[var(--color-text)]">Cognitive Functional Therapy</strong> — the approach validated in
        the 2023 Lancet RESTORE trial and still holding at the three-year follow-up. CFT treats pain as what the
        science says it is: a protective output of the nervous system, shaped by load, belief, fear, sleep and
        stress. Not a readout of tissue damage. Change those inputs in the right order and most persistent pain
        changes with them.
      </p>
      <p>
        The combination is the part that's rare. <strong class="text-[var(--color-text)]">Most CFT practitioners
        aren't strength coaches, and most strength coaches have never heard of CFT.</strong> I do both, in the same
        room, in the same hour — calm the system down, then build the body back up, progressively and specifically
        for what <em>you</em> want back. Nothing gets handed between two providers who never speak to each other.
      </p>
      <p>
        The studio is at {SITE.contact.address.street} in downtown Denver. One-on-one, 60–90 minutes, because that
        is honestly what the work takes.
      </p>
    </div>
  </section>

  <section class="px-6 py-16 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-8">Credentials</h2>
      <ul class="space-y-4">
        {SITE.credentials.map(c => (
          <li class="flex items-start gap-4">
            <span class="text-[var(--color-primary)] text-2xl leading-none mt-1 flex-shrink-0">✓</span>
            <span class="text-lg">{c.name}</span>
          </li>
        ))}
      </ul>
      <h2 class="mt-14 mb-8">Seen in &amp; contributed to</h2>
      <ul class="space-y-4">
        {SITE.media.map(m => (
          <li class="flex items-start gap-4">
            <span class="text-[var(--color-primary)] text-2xl leading-none mt-1 flex-shrink-0">✓</span>
            <span class="text-lg">{m.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="px-6 py-20">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="mb-6">Want to know if this is the right fit?</h2>
      <p class="text-lg text-[var(--color-text-muted)] mb-8">
        A 30-minute Discovery Session ($57, normally $97) gets you an honest answer.
      </p>
      <a href="/book" class="cta-button text-lg">Book a consultation</a>
    </div>
  </section>
</BaseLayout>
