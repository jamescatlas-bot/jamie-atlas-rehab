---
import BaseLayout from '../layouts/BaseLayout.astro';
import BannerSection from '../components/BannerSection.astro';
import { SITE } from '../data/site';

const steps = [
  {
    title: '1. A 30-minute Discovery Session ($57, normally $97)',
    body: "You tell me the story — when it started, what you've already tried, what you actually want back. Then I tell you honestly whether I can help. <strong>If I can't, I'll say so and point you at someone who can.</strong> Either way you leave with a clearer picture than you arrived with.",
  },
  {
    title: '2. Full assessment — first session, 90 minutes',
    body: "I assess how you move, not just where it hurts. <strong>The sore spot is the symptom. It's rarely where the problem is being decided.</strong> We usually change your pain in that session, in real time, so you get to feel what's possible before you commit to anything.",
  },
  {
    title: '3. A plan with a number on it',
    body: "You leave the assessment knowing roughly how many sessions this takes — typically six to eight — what happens in them, and what you'll do between them. <strong>A number, not an open tab.</strong>",
  },
  {
    title: '4. The actual work',
    body: "Weekly or every other week, 45–60 minutes. Three things at once: settling the pain system down, going back into the movements you quietly stopped making, and loading you until your capacity clears what your life and your sport ask of it.",
  },
  {
    title: '5. Benchmarks, not guesswork',
    body: "Readiness gets tested, not estimated. Strength, range and confidence, measured against your sport. <strong>That's how you go back without spending the whole first season braced for it to go again.</strong>",
  },
  {
    title: '6. Graduation',
    body: "You leave with a program you own, an understanding of why this happened, and a plan for the day it flares — because it might, and that day is much less frightening when you already know what to do. Some people keep a monthly check-in. Most just go and live.",
  },
];
---

<BaseLayout
  title="How It Works — Rehab in Denver, Start to Graduation"
  description="Discovery Session → full assessment → a plan with a number on it → progressive work → return-to-sport benchmarks → graduation. How rehab works at Jamie Atlas."
>
  <section class="px-6 pt-16 pb-12 md:pt-24">
    <div class="max-w-3xl mx-auto">
      <p class="font-serif italic text-[var(--color-primary)] mb-3 text-lg">How it works</p>
      <h1 class="mb-8">A clear process, with an end date</h1>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed">
        You have probably been somewhere that never told you when it would stop. Come back Tuesday. Come back
        Thursday. See how you go. <strong class="text-[var(--color-text)]">The goal here is to make myself
        unnecessary</strong>, and that only works if the plan has a shape you can see from the start. So here is
        the whole thing, first call to graduation.
      </p>
    </div>
  </section>

  <!-- Site-wide rotating video banner (Jamie, 2026-08-08) -->
  <BannerSection />

  <section class="px-6 py-16 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div class="max-w-3xl mx-auto space-y-12">
      {steps.map(s => (
        <div>
          <h2 class="mb-4 text-2xl">{s.title}</h2>
          <p class="text-lg text-[var(--color-text-muted)] leading-relaxed" set:html={s.body} />
        </div>
      ))}
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-6">What you won't get</h2>
      <ul class="space-y-4 text-lg text-[var(--color-text-muted)]">
        <li class="flex items-start gap-4">
          <span class="text-[var(--color-primary)] text-xl leading-none mt-1.5 flex-shrink-0">✕</span>
          <span>Being frightened about your spine, your knees, or your age</span>
        </li>
        <li class="flex items-start gap-4">
          <span class="text-[var(--color-primary)] text-xl leading-none mt-1.5 flex-shrink-0">✕</span>
          <span>Twelve minutes shared with three other people on other tables</span>
        </li>
        <li class="flex items-start gap-4">
          <span class="text-[var(--color-primary)] text-xl leading-none mt-1.5 flex-shrink-0">✕</span>
          <span>Passive treatment — heat, ultrasound, adjustments — that feels good on the day and changes nothing by Thursday</span>
        </li>
        <li class="flex items-start gap-4">
          <span class="text-[var(--color-primary)] text-xl leading-none mt-1.5 flex-shrink-0">✕</span>
          <span>A plan with no end written into it</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="px-6 py-20 bg-[var(--color-primary)] text-on-dark">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="mb-6 text-white">Step one is one session</h2>
      <p class="text-xl mb-10 opacity-95">Book the 30-minute Discovery Session — $57 right now, normally $97 — and find out if this is the right fit.</p>
      <a href="/book" class="cta-button cta-button-accent text-lg">Book a consultation</a>
    </div>
  </section>
</BaseLayout>
