---
import { SITE } from '../data/site';
import { REVIEWS_URL } from '../data/reviews';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
// Fonts are self-hosted via @fontsource (bundled by Astro) instead of the old
// Google Fonts <link> — no render-blocking third-party request, and the brand
// font (Quicksand, matched to the logo lettering) always loads.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/quicksand/500.css';
import '@fontsource/quicksand/600.css';
import '@fontsource/quicksand/700.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = SITE.description, image = '/og-default.png', noindex = false } = Astro.props;
// Home passes a full keyworded title; interior pages get a short brand suffix.
const fullTitle = title.includes(SITE.shortName) ? title : `${title} | ${SITE.shortName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(image, Astro.site).href;

// Jamie as a named entity, so credentials attach to a person rather than
// floating as page text. Helps Google resolve who is delivering the care.
const founderSchema = {
  '@type': 'Person',
  '@id': `${SITE.url}/#jamie`,
  name: 'Jamie Atlas',
  // Title decided 2026-08-07: plain-English title sells, certification
  // credentials. CFT stays in hasCredential/knowsAbout, never as the title.
  jobTitle: 'Pain & Performance Specialist',
  url: `${SITE.url}/about`,
  hasCredential: SITE.credentials.map(c => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.name,
  })),
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'LocalBusiness', 'PhysicalTherapy'],
  '@id': SITE.url,
  name: SITE.name,
  // Legacy trading names — lets Google reconcile the old Bonza Bodies
  // citations and this business as a single entity.
  alternateName: [...SITE.alternateNames],
  url: SITE.url,
  image: ogImageUrl,
  telephone: SITE.contact.phone,
  email: SITE.contact.email,
  description: SITE.description,
  priceRange: '$$',
  medicalSpecialty: 'PhysicalTherapy',
  founder: founderSchema,
  employee: { '@id': `${SITE.url}/#jamie` },
  availableService: SITE.services.map(s => ({
    '@type': 'MedicalTherapy',
    name: s,
  })),
  hasMap: `https://www.google.com/maps/place/?q=place_id:${SITE.placeId}`,
  sameAs: [SITE.social.instagramUrl, REVIEWS_URL, ...SITE.profiles],
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${SITE.contact.address.street}, ${SITE.contact.address.level}`,
    addressLocality: SITE.contact.address.city,
    addressRegion: SITE.contact.address.state,
    postalCode: SITE.contact.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.contact.address.lat,
    longitude: SITE.contact.address.lng,
  },
  areaServed: SITE.serviceArea.map(city => ({ '@type': 'City', name: city })),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '05:00',
      closes: '19:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '07:30',
      closes: '16:00',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <!-- Google Analytics (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NX0CJB6460"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-NX0CJB6460');
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
