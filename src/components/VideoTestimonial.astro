---
// Click-to-play YouTube facade, laid out for VERTICAL video.
//
// Two things drive this component:
//
// 1. PERFORMANCE. Each YouTube embed pulls ~700KB of player JS on load. Three
//    on a page would wreck mobile load time, which is where nearly all of
//    Jamie's clients arrive. This renders a thumbnail and only loads the real
//    player when someone actually taps. With JavaScript off it degrades to a
//    working link to YouTube.
//
// 2. SHAPE. These clips are YouTube Shorts — 9:16 portrait, not 16:9. A
//    portrait video in a widescreen box gets black bars down both sides and
//    reads as broken. The frame here is portrait, capped at 300px wide so it
//    never dominates the row.
//
// The narrow video leaves natural room beside it, which is where the client's
// history goes (`bio` in videos.ts). Desktop: text left, video right. Mobile:
// video first, text underneath — the clip is the hook, the context is the
// follow-up.
//
// Thumbnails: `oardefault.jpg` preserves a Short's original portrait framing.
// It does not exist for every video, so there is an onerror fallback to
// `hqdefault.jpg`, which always exists.
import type { Testimonial } from '../data/videos';

interface Props {
  video: Testimonial;
  headingLevel?: 'h3' | 'h4';
  // Homepage "Option B" treatment (Jamie, 2026-08-08): a solid-blue panel with
  // the client's own words in giant white text replaces the headline/bio, and
  // a large circle badge ("CLICK HERE TO SEE HER RESULTS") replaces the small
  // play button. All three props omitted = component renders exactly as before.
  quote?: string;
  quoteName?: string;
  badgeText?: string;
}

const { video, headingLevel = 'h3', quote, quoteName, badgeText } = Astro.props;
const Heading = headingLevel;
const hasBio = Boolean(video.bio && video.bio.trim().length > 0);

// Frame shape per clip. Getting this wrong is visible: a widescreen clip in a
// portrait box loses both edges of the frame, and a portrait clip in a
// widescreen box gets black bars down each side.
//
// Widescreen and 4:3 clips also need a wider column than a Short does, or they
// render postage-stamp sized next to the text.
const SHAPE = {
  portrait: {
    aspect: 'aspect-[9/16]',
    maxWidth: 'max-w-[300px]',
    column: 'md:grid-cols-[minmax(0,1fr)_300px]',
    thumb: 'oardefault', // preserves a Short's portrait framing
    w: 405,
    h: 720,
  },
  landscape: {
    aspect: 'aspect-video',
    maxWidth: 'max-w-[560px]',
    column: 'md:grid-cols-[minmax(0,1fr)_minmax(0,560px)]',
    thumb: 'maxresdefault',
    w: 1280,
    h: 720,
  },
  classic: {
    aspect: 'aspect-[4/3]',
    maxWidth: 'max-w-[480px]',
    column: 'md:grid-cols-[minmax(0,1fr)_minmax(0,480px)]',
    thumb: 'hqdefault',
    w: 480,
    h: 360,
  },
} as const;

const shape = SHAPE[video.orientation ?? 'portrait'];

// Mobile sizing for the banner/quote mode (Jamie, 2026-08-09): 80% of traffic
// is phones, and a full-size portrait clip + quote panel overflowed the screen.
// In quote mode on mobile the quote sits ABOVE a two-thirds-size video so one
// slide fits a phone screen; from md: up, nothing changes (quote left, full
// 300px video right).
const isPortrait = (video.orientation ?? 'portrait') === 'portrait';
const facadeWidth = quote && isPortrait ? 'max-w-[210px] md:max-w-[300px]' : shape.maxWidth;
const captionOrder = quote ? 'order-1' : 'order-2 md:order-1';
const facadeOrder = quote ? 'order-2 mx-auto md:mx-0' : 'order-1 md:order-2';
---

<figure class={`m-0 grid ${quote ? 'gap-4' : 'gap-6'} ${shape.column} md:gap-10 md:items-start`}>
  <figcaption class={captionOrder}>
    {quote ? (
      <>
        <div class="bg-[var(--color-primary)] rounded-2xl p-5 md:p-10">
          <p class="text-white font-extrabold leading-snug md:leading-tight text-xl md:text-4xl m-0">
            &ldquo;{quote}&rdquo;
          </p>
          {quoteName && (
            <span class="block mt-3 md:mt-5 text-base md:text-lg font-bold text-[#FFD9A8]">— {quoteName}</span>
          )}
        </div>
        {video.note && (
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)] opacity-75">
            {video.note}
          </p>
        )}
      </>
    ) : (
      <>
        <Heading class="mb-3">{video.headline}</Heading>

        {hasBio ? (
          <p class="text-base leading-relaxed text-[var(--color-text-muted)] whitespace-pre-line">
            {video.bio}
          </p>
        ) : (
          <p class="text-base leading-relaxed text-[var(--color-text-muted)]">
            {video.title.replace(/^Client testimonial — /, '')}
          </p>
        )}

        {video.note && (
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)] opacity-75">
            {video.note}
          </p>
        )}
      </>
    )}
  </figcaption>

  <a
    class={`video-facade group relative ${facadeOrder} block ${shape.aspect} w-full ${facadeWidth} overflow-hidden rounded-xl border border-[var(--color-border)] bg-black no-underline`}
    href={`https://www.youtube.com/watch?v=${video.id}`}
    data-video-id={video.id}
    data-video-title={video.title}
    rel="noopener"
  >
    <img
      src={`https://i.ytimg.com/vi/${video.id}/${shape.thumb}.jpg`}
      data-fallback={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
      alt={video.title}
      width={shape.w}
      height={shape.h}
      loading="lazy"
      class="video-thumb absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
    <span class="absolute inset-0 bg-black/15 transition-colors group-hover:bg-black/25"></span>
    {badgeText ? (
      <span
        class="absolute left-1/2 top-1/2 flex h-28 w-28 md:h-40 md:w-40 -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center gap-1 md:gap-1.5 rounded-full border-4 border-[var(--color-accent)] bg-white/95 px-2 md:px-4 text-center shadow-lg transition-transform duration-200 group-hover:scale-105"
        aria-hidden="true"
      >
        <svg class="w-3.5 md:w-[18px]" viewBox="0 0 22 24" fill="var(--color-primary)">
          <path d="M21 12L0 24V0z" />
        </svg>
        <span class="text-[10px] md:text-[13px] font-extrabold leading-snug text-[var(--color-primary)]">{badgeText}</span>
      </span>
    ) : (
      <span
        class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/95 shadow-lg transition-transform duration-200 group-hover:scale-110"
        aria-hidden="true"
      >
        <svg width="22" height="24" viewBox="0 0 22 24" fill="var(--color-primary)">
          <path d="M21 12L0 24V0z" />
        </svg>
      </span>
    )}
    <span class="sr-only">Play video: {video.title}</span>
  </a>
</figure>

<script>
  // Fall back to hqdefault.jpg where a Short has no oardefault.jpg.
  document.querySelectorAll<HTMLImageElement>('img.video-thumb').forEach(img => {
    img.addEventListener(
      'error',
      () => {
        const fallback = img.dataset.fallback;
        if (fallback && img.src !== fallback) img.src = fallback;
      },
      { once: true }
    );
  });

  // Swap the thumbnail for the real player on click. Runs once per page.
  //
  // MOBILE (Jamie, 2026-08-09): phones reported taps "not working" — the inline
  // embed + autoplay is unreliable on mobile browsers (iOS often loads the
  // player but refuses to start it, which reads as a dead tap). On touch
  // devices we let the link do its natural thing instead: open the video in
  // the YouTube app / player, which always works. Desktop keeps the inline
  // embed.
  const touchDevice = window.matchMedia('(pointer: coarse)').matches;
  document.querySelectorAll('.video-facade').forEach(el => {
    el.addEventListener('click', (event: Event) => {
      if (touchDevice) return; // follow the link → YouTube app/player
      event.preventDefault();
      const link = el as HTMLAnchorElement;
      const id = link.dataset.videoId;
      const title = link.dataset.videoTitle ?? 'Video';
      if (!id) return;

      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      frame.title = title;
      frame.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'absolute inset-0 h-full w-full';
      frame.setAttribute('frameborder', '0');

      link.replaceChildren(frame);
      link.classList.add('pointer-events-none');
    });
  });
</script>
