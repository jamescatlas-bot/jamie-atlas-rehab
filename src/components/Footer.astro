---
import { SITE } from '../data/site';
import { CONDITIONS } from '../data/conditions';

const year = new Date().getFullYear();

const pages = [
  { label: 'Personal training', href: '/personal-trainer-denver' },
  { label: 'Training on a GLP-1', href: '/personal-trainer-denver/glp-1' },
  { label: 'Training with a bad back', href: '/personal-trainer-denver/back-pain' },
  { label: 'Strength over 40, 50 and 60', href: '/personal-trainer-denver/over-40' },
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'About Jamie', href: '/about' },
  { label: 'The Studio', href: '/studio' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Client Results', href: '/testimonials' },
  { label: 'Press & Awards', href: '/press' },
  { label: 'Resources', href: '/resources' },
  { label: 'Book a 30-minute assessment', href: '/book' },
];

// The condition pages: no longer in the header (doc 71 §3), so they live here
// and on the hub. The CFT page is a method, not a condition; it stays out.
const workWith = CONDITIONS.filter(c => c.slug !== 'cognitive-functional-therapy').map(c => ({
  label: c.navTitle,
  href: `/what-i-work-with/${c.slug}`,
}));
---

<!-- Brand-blue footer band: the reversed (white) logo lives here, on the same
     blue it was designed for. Link colors are handled by .footer-brand in
     global.css because the base `a` color would vanish on this background. -->
<footer class="footer-brand bg-[var(--color-primary)] text-white mt-24">
  <div class="max-w-6xl mx-auto px-6 py-16 grid md:grid-cols-5 gap-10 text-sm">

    <div>
      <img
        src="/logo-white.png"
        alt={`${SITE.name}, Love Your Body`}
        width="560"
        height="212"
        loading="lazy"
        class="w-44 h-auto mb-5"
      />
      <address class="not-italic text-white/85 leading-relaxed">
        {SITE.contact.address.street}<br />
        {SITE.contact.address.level}<br />
        {SITE.contact.address.city}, {SITE.contact.address.state} {SITE.contact.address.zip}
      </address>
      <p class="mt-4 text-white/85 leading-relaxed">
        Serving {SITE.serviceArea.join(', ')}.
      </p>
    </div>

    <div>
      <p class="font-semibold mb-4 text-white">Pages</p>
      <ul class="space-y-2">
        {pages.map(p => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-semibold mb-4 text-white">What I work with</p>
      <ul class="space-y-2">
        {workWith.map(p => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
        <li><a href="/what-i-work-with">Everything I work with →</a></li>
      </ul>
    </div>

    <div>
      <p class="font-semibold mb-4 text-white">Contact</p>
      <ul class="space-y-2">
        <li><a href={`tel:${SITE.contact.phoneTel}`}>{SITE.contact.phone}</a></li>
        <li><a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a></li>
        <li><a href="/book">Book a 30-minute assessment</a></li>
        <li><a href={SITE.social.instagramUrl}>{SITE.social.instagram}</a></li>
      </ul>
    </div>

    <div>
      <p class="font-semibold mb-4 text-white">Hours</p>
      <ul class="space-y-2 text-white/85">
        <li>Monday – Friday: {SITE.hours.weekdays}</li>
        <li>Saturday: {SITE.hours.saturday}</li>
        <li>Sunday: {SITE.hours.sunday}</li>
      </ul>
    </div>

  </div>

  <div class="border-t border-white/20 py-6 px-6 text-center text-xs text-white/75">
    © {year} {SITE.name}. Formerly Bonza Bodies Fitness. All rights reserved.
  </div>
</footer>
