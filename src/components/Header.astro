---
// Nav per doc 70 §2.2 / doc 71 §3 (Jamie, 9 Sep 2026): five items plus the
// Book button. "Who it's for" opens the three doors and the by-activity pages;
// the condition pages live under Training (the hub) and in the footer.
const nav = [
  { label: 'Training', href: '/personal-trainer-denver', hint: 'Personal training in downtown Denver, studio or Zoom' },
  {
    label: "Who it's for",
    href: '/this-is-you/worried-about-reinjury',
    children: [
      { label: 'Get better at my sport without getting hurt again', href: '/this-is-you/worried-about-reinjury' },
      { label: "I'm hurt and I want to get better", href: '/this-is-you/still-in-pain' },
      { label: 'Lose the weight and keep the muscle', href: '/personal-trainer-denver/glp-1' },
      { label: 'Cleared, but not feeling ready', href: '/this-is-you/cleared-but-not-ready' },
      { label: 'By activity: skiers, golfers, runners...', href: '/for' },
      { label: 'By body part: back, neck, knee, shoulder', href: '/what-i-work-with' },
    ],
  },
  { label: 'Reviews', href: '/reviews', hint: 'Google reviews and client video results' },
  { label: 'Studio', href: '/studio', hint: 'Location, parking, and a look inside' },
  { label: 'About', href: '/about', hint: 'Who Jamie is and why this studio exists' },
];
---

<header class="border-b border-[var(--color-border)] bg-[var(--color-surface)] sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between gap-3 sm:gap-6">
    <!-- whitespace-nowrap stops the wordmark breaking onto two lines on phones -->
    <a
      href="/"
      class="flex items-center gap-2.5 sm:gap-3 font-serif text-lg sm:text-xl font-bold no-underline text-[var(--color-primary)] uppercase tracking-[0.08em] leading-none whitespace-nowrap shrink-0"
    >
      <!-- Blue JA logo card so visitors know they're in the right place (Jamie, 2026-08-06) -->
      <img
        src="/logo-blue.png"
        alt="Jamie Atlas Personal Training & Rehabilitation, Denver"
        width="400"
        height="200"
        class="h-9 sm:h-10 w-auto"
      />
      <!-- Jamie 2026-08-07: name lives in the logo card, so the text beside it
           is the service line, not the name. -->
      <span class="normal-case tracking-normal font-semibold text-sm sm:text-base xl:text-lg">Personal Training &amp; Rehabilitation</span>
    </a>

    <nav class="hidden lg:flex items-center gap-5 xl:gap-7">
      {nav.map(item =>
        item.children ? (
          <div class="relative group">
            <a
              href={item.href}
              class="text-sm no-underline whitespace-nowrap text-[var(--color-text-muted)] hover:text-[var(--color-text)] inline-flex items-center gap-1"
            >
              {item.label}
              <svg width="9" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg>
            </a>
            <!-- pt-3 bridge keeps the menu open while the mouse travels down to it -->
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 hidden group-hover:block z-50">
              <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl shadow-lg p-2 w-80 flex flex-col">
                {item.children.map(c => (
                  <a
                    href={c.href}
                    class="px-3 py-2.5 rounded-lg text-sm no-underline text-[var(--color-text)] hover:bg-[var(--color-background)] hover:text-[var(--color-primary)]"
                  >
                    {c.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            title={item.hint}
            class="text-sm no-underline whitespace-nowrap text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
          >
            {item.label}
          </a>
        )
      )}
    </nav>

    <div class="flex items-center gap-1 sm:gap-3">
      <!-- Jamie 2026-08-07: no Book button in the header on phones — the hero
           CTA is already on the first screen. Desktop keeps it (the header is
           sticky, so it's the persistent CTA once the hero scrolls away). -->
      <a href="/book" class="cta-button text-sm whitespace-nowrap hidden sm:inline-block sm:px-7 sm:py-3.5">
        Book · $57
      </a>

      <!-- Mobile menu: no-JS details/summary pattern -->
      <details class="lg:hidden relative">
        <summary
          class="list-none cursor-pointer p-2.5 -mr-1 text-[var(--color-text)]"
          aria-label="Open menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </summary>
        <nav class="absolute right-0 top-full mt-3 w-56 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl shadow-lg p-3 flex flex-col">
          {nav.map(item => (
            <a
              href={item.href}
              class="px-3 py-2.5 rounded-lg text-base no-underline text-[var(--color-text)] hover:bg-[var(--color-background)]"
            >
              {item.label}
            </a>
          ))}
          <a
            href="/book"
            class="px-3 py-2.5 rounded-lg text-base no-underline font-semibold text-[var(--color-primary)] hover:bg-[var(--color-background)]"
          >
            Book a 30-minute assessment · $57
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
