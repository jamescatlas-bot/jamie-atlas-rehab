---
const nav = [
  { label: 'What We Treat', href: '/what-we-treat' },
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'About', href: '/about' },
  { label: 'Studio', href: '/studio' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Resources', href: '/resources' },
];
---

<header class="border-b border-[var(--color-border)] bg-[var(--color-surface)] sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between gap-6">
    <a href="/" class="font-serif text-lg md:text-xl font-semibold no-underline text-[var(--color-text)] leading-tight">
      Jamie Atlas <span class="hidden md:inline">Rehab &amp; Performance</span>
    </a>
    <nav class="hidden lg:flex items-center gap-7">
      {nav.map(item => (
        <a
          href={item.href}
          class="text-sm no-underline text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/book" class="cta-button text-sm whitespace-nowrap">Book consultation</a>

      <!-- Mobile menu: no-JS details/summary pattern -->
      <details class="lg:hidden relative">
        <summary
          class="list-none cursor-pointer p-2 -m-2 text-[var(--color-text)]"
          aria-label="Open menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </summary>
        <nav class="absolute right-0 top-full mt-3 w-56 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl shadow-lg p-3 flex flex-col">
          {nav.map(item => (
            <a
              href={item.href}
              class="px-3 py-2.5 rounded-lg text-base no-underline text-[var(--color-text)] hover:bg-[var(--color-background)]"
            >
              {item.label}
            </a>
          ))}
          <a
            href="/book"
            class="px-3 py-2.5 rounded-lg text-base no-underline font-semibold text-[var(--color-primary)] hover:bg-[var(--color-background)]"
          >
            Book a consultation
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
