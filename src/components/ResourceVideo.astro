---
// Click-to-play YouTube facade for LANDSCAPE press/segment clips on resource
// article pages. Same behaviour as VideoTestimonial: nothing loads from
// YouTube until a tap; desktop swaps in the player inline, touch devices
// follow the link to the YouTube app (inline autoplay reads as a dead tap on
// iOS). Astro dedupes this component's <script> per page.
interface Props {
  id: string;
  title: string;
  caption?: string;
}
const { id, title, caption } = Astro.props;
---

<figure class="m-0">
  <a
    class="resource-video-facade group relative block aspect-video w-full overflow-hidden rounded-xl border border-[var(--color-border)] bg-black no-underline"
    href={`https://www.youtube.com/watch?v=${id}`}
    data-video-id={id}
    data-video-title={title}
    rel="noopener"
  >
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt={title}
      width="1280"
      height="720"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
    <span class="absolute inset-0 bg-black/15 transition-colors group-hover:bg-black/25"></span>
    <span
      class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/95 shadow-lg transition-transform duration-200 group-hover:scale-110"
      aria-hidden="true"
    >
      <svg width="22" height="24" viewBox="0 0 22 24" fill="var(--color-primary)">
        <path d="M21 12L0 24V0z" />
      </svg>
    </span>
    <span class="sr-only">Play video: {title}</span>
  </a>
  {caption && (
    <figcaption class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)] opacity-75">
      {caption}
    </figcaption>
  )}
</figure>

<script>
  const touchDevice = window.matchMedia('(pointer: coarse)').matches;
  document.querySelectorAll('.resource-video-facade').forEach(el => {
    el.addEventListener('click', (event: Event) => {
      if (touchDevice) return;
      event.preventDefault();
      const link = el as HTMLAnchorElement;
      const id = link.dataset.videoId;
      const title = link.dataset.videoTitle ?? 'Video';
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      frame.title = title;
      frame.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'absolute inset-0 h-full w-full';
      frame.setAttribute('frameborder', '0');
      link.replaceChildren(frame);
      link.classList.add('pointer-events-none');
    });
  });
</script>
